# 开发环境特定的环境变量

# API 基础 URL - SSR 模式下需要使用完整的后端地址
PUBLIC_API_BASE_URL=https://flexible.china9.cn/api
PUBLIC_CHINA9_API_BASE_URL=https://china9.cn/api

# 开发服务器配置
PUBLIC_DEV_SERVER_PORT=3000
PUBLIC_DEV_SERVER_HOST=localhost

# 调试模式
PUBLIC_DEBUG_MODE=true

# 模拟数据
PUBLIC_USE_MOCK_DATA=true

# 日志级别
PUBLIC_LOG_LEVEL=debug

# WebSocket 服务
PUBLIC_WEBSOCKET_URL=ws://localhost:3000/ws

# 资源路径
PUBLIC_ASSETS_PATH=/assets/

# 开发环境的第三方服务配置
PUBLIC_MAP_API_KEY=dev_map_api_key_here