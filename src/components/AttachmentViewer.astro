---
interface Props {
  attachments?: any[];
}

const { attachments = [] } = Astro.props;

// 判断文件类型
function getFileType(filename: string) {
  const ext = filename.split('.').pop()?.toLowerCase();
  const imageExts = ['jpg', 'jpeg', 'png', 'gif', 'bmp', 'webp', 'svg'];
  const docExts = ['doc', 'docx', 'xls', 'xlsx', 'ppt', 'pptx', 'pdf'];

  if (imageExts.includes(ext || '')) return 'image';
  if (docExts.includes(ext || '')) return 'document';
  return 'other';
}

// 获取文件图标
function getFileIcon(filename: string) {
  const ext = filename.split('.').pop()?.toLowerCase();

  switch(ext) {
    case 'doc':
    case 'docx':
      return '📄';
    case 'xls':
    case 'xlsx':
      return '📊';
    case 'ppt':
    case 'pptx':
      return '📽️';
    case 'pdf':
      return '📕';
    case 'zip':
    case 'rar':
      return '📦';
    default:
      return '📎';
  }
}
---

{attachments && attachments.length > 0 && (
  <div class="attachment-viewer">
    <div class="attachment-list">
      {attachments.map((file: any) => {
        const fileType = getFileType(file.name || file.filename);

        if (fileType === 'image') {
          return (
            <div class="attachment-item attachment-image">
              <img
                src={file.url || file.path}
                alt={file.name || file.filename}
                class="attachment-thumbnail"
                onclick={`openImagePreview('${file.url || file.path}')`}
              />
              <div class="attachment-name">{file.name || file.filename}</div>
            </div>
          );
        } else {
          return (
            <a
              href={file.url || file.path}
              class="attachment-item attachment-file"
              download={file.name || file.filename}
              target="_blank"
            >
              <div class="attachment-icon">{getFileIcon(file.name || file.filename)}</div>
              <div class="attachment-info">
                <div class="attachment-name">{file.name || file.filename}</div>
                {file.size && <div class="attachment-size">{file.size}</div>}
              </div>
              <div class="attachment-download">📥</div>
            </a>
          );
        }
      })}
    </div>
  </div>

  <!-- 图片预览遮罩层 -->
  <div id="imagePreviewModal" class="image-preview-modal" onclick="closeImagePreview()">
    <span class="preview-close">✕</span>
    <img id="previewImage" class="preview-image" alt="预览" />
  </div>
)}

<style>
  .attachment-viewer {
    margin-top: 12px;
  }

  .attachment-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
    gap: 12px;
  }

  .attachment-item {
    border-radius: 12px;
    overflow: hidden;
    transition: all 0.3s ease;
    cursor: pointer;
  }

  .attachment-image {
    position: relative;
    background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
    border: 1px solid #e2e8f0;
    padding: 8px;
  }

  .attachment-image:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 16px rgba(0, 0, 0, 0.1);
    border-color: #cbd5e1;
  }

  .attachment-thumbnail {
    width: 100%;
    height: 120px;
    object-fit: cover;
    border-radius: 8px;
    background: #f8fafc;
  }

  .attachment-image .attachment-name {
    margin-top: 8px;
    font-size: 12px;
    color: #64748b;
    text-align: center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .attachment-file {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 16px;
    background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    text-decoration: none;
    color: inherit;
    grid-column: 1 / -1;
  }

  .attachment-file:hover {
    background: linear-gradient(135deg, #f1f5f9 0%, #e2e8f0 100%);
    border-color: #cbd5e1;
    transform: translateY(-1px);
  }

  .attachment-icon {
    font-size: 32px;
    flex-shrink: 0;
  }

  .attachment-info {
    flex: 1;
    min-width: 0;
  }

  .attachment-file .attachment-name {
    font-size: 14px;
    font-weight: 500;
    color: #1e293b;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    margin-bottom: 4px;
  }

  .attachment-size {
    font-size: 12px;
    color: #64748b;
  }

  .attachment-download {
    font-size: 20px;
    color: #64748b;
    flex-shrink: 0;
  }

  /* 图片预览遮罩层 */
  .image-preview-modal {
    display: none;
    position: fixed;
    z-index: 9999;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.9);
    align-items: center;
    justify-content: center;
    animation: fadeIn 0.3s ease;
  }

  .image-preview-modal.active {
    display: flex;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  .preview-close {
    position: absolute;
    top: 20px;
    right: 30px;
    font-size: 40px;
    font-weight: 300;
    color: white;
    cursor: pointer;
    z-index: 10000;
    transition: all 0.3s ease;
  }

  .preview-close:hover {
    color: #f56565;
    transform: scale(1.1);
  }

  .preview-image {
    max-width: 90%;
    max-height: 90%;
    object-fit: contain;
    animation: zoomIn 0.3s ease;
  }

  @keyframes zoomIn {
    from {
      transform: scale(0.8);
      opacity: 0;
    }
    to {
      transform: scale(1);
      opacity: 1;
    }
  }
</style>

<script is:inline>
  // 打开图片预览
  window.openImagePreview = function(imageUrl) {
    const modal = document.getElementById('imagePreviewModal');
    const previewImage = document.getElementById('previewImage');

    if (modal && previewImage) {
      previewImage.src = imageUrl;
      modal.classList.add('active');
      document.body.style.overflow = 'hidden';
    }
  };

  // 关闭图片预览
  window.closeImagePreview = function() {
    const modal = document.getElementById('imagePreviewModal');

    if (modal) {
      modal.classList.remove('active');
      document.body.style.overflow = '';
    }
  };

  // ESC键关闭预览
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
      window.closeImagePreview();
    }
  });
</script>
