    display: flex;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 12px;
  }

  .task-title {
    font-size: 15px;
    font-weight: 700;
    color: #0f172a;
  }

  .task-module {
    font-size: 12px;
    color: #94a3b8;
  }

  .task-meta-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
  }

  .task-description {
    margin-top: 12px;
    padding: 10px;
    border-radius: 12px;
    background: #f8fafc;
    color: #475569;
    font-size: 13px;
    line-height: 1.4;
  }

  .task-actions {
    margin-top: 12px;
    display: flex;
    justify-content: flex-end;
    gap: 8px;
  }

  @media (min-width: 640px) {
    .project-performance-card {
      padding: 24px;
    }

    .dispatch-modal {
      align-items: center;
    }

    .dispatch-modal-content {
      border-radius: 24px;
    }
  }
</style>

<script is:inline define:vars={modalId, defaultFilterKey}>
  (() => {
    const modalId = JSON.stringify(modalId);
    const defaultFilterKey = JSON.stringify(defaultFilterKey);
    const modal = document.getElementById(modalId);
    if (!modal) return;

    const openButtons = document.querySelectorAll("[data-open-dispatch]");
    const closeButtons = modal.querySelectorAll("[data-close-dispatch]");
    const filterButtons = modal.querySelectorAll("[data-dispatch-filter]");
    const taskCards = modal.querySelectorAll("[data-status-key]");

    const toggleModal = (open) => {
      modal.classList.toggle("active", open);
      document.body.classList.toggle("dispatch-modal-open", open);
    };

    openButtons.forEach((button) => {
      button.addEventListener("click", () => toggleModal(true));
    });

    closeButtons.forEach((button) => {
      button.addEventListener("click", () => toggleModal(false));
    });

    modal.addEventListener("click", (event) => {
      if (event.target === modal) {
        toggleModal(false);
      }
    });

    const applyFilter = (targetKey) => {
      filterButtons.forEach((button) => {
        const key = button.getAttribute("data-dispatch-filter");
        const isActive = key === targetKey;
        if (isActive) {
          button.classList.add("active");
        } else {
          button.classList.remove("active");
        }
      });

      taskCards.forEach((card) => {
        const statusKey = card.getAttribute("data-status-key") || "all";
        if (targetKey === "all" || statusKey === targetKey) {
          card.removeAttribute("hidden");
        } else {
          card.setAttribute("hidden", "true");
        }
      });
    };

    filterButtons.forEach((button) => {
      button.addEventListener("click", () => {
        const selected = button.getAttribute("data-dispatch-filter") || "all";
        applyFilter(selected);
      });
    });

    applyFilter(defaultFilterKey);
  })();
</script>
