<script is:inline define:vars={{modalId, defaultFilterKey}}>
  (() => {
    const modalElementId = String(modalId);
    const fallbackFilterKey = String(defaultFilterKey || "all");
    const modal = document.getElementById(modalElementId);
    if (!modal) return;

    const openButtons = document.querySelectorAll("[data-open-dispatch]");
    const closeButtons = modal.querySelectorAll("[data-close-dispatch]");
    const filterButtons = modal.querySelectorAll("[data-dispatch-filter]");
    const taskCards = modal.querySelectorAll("[data-status-key]");

    const toggleModal = (open) => {
      modal.classList.toggle("active", open);
      document.body.classList.toggle("dispatch-modal-open", open);
    };

    openButtons.forEach((button) => {
      button.addEventListener("click", () => toggleModal(true));
    });

    closeButtons.forEach((button) => {
      button.addEventListener("click", () => toggleModal(false));
    });

    modal.addEventListener("click", (event) => {
      if (event.target === modal) {
        toggleModal(false);
      }
    });

    const applyFilter = (targetKey) => {
      filterButtons.forEach((button) => {
        const key = button.getAttribute("data-dispatch-filter");
        const isActive = key === targetKey;
        if (isActive) {
          button.classList.add("active");
        } else {
          button.classList.remove("active");
        }
      });

      taskCards.forEach((card) => {
        const statusKey = card.getAttribute("data-status-key") || "all";
        if (targetKey === "all" || statusKey === targetKey) {
          card.removeAttribute("hidden");
        } else {
          card.setAttribute("hidden", "true");
        }
      });
    };

    filterButtons.forEach((button) => {
      button.addEventListener("click", () => {
        const selected = button.getAttribute("data-dispatch-filter") || "all";
        applyFilter(selected);
      });
    });

    applyFilter(fallbackFilterKey);
  })();
</script>
