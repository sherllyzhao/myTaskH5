<script is:inline define:vars={{modalId, defaultFilterKey, projectPerformanceInfo, data}}>
  window.__projectPerformanceInfo__ = projectPerformanceInfo;
  window.__projectDetail__ = data;
  (() => {
    const modalElementId = String(modalId);
    const fallbackFilterKey = String(defaultFilterKey || "all");
    const modal = document.getElementById(modalElementId);
    if (!modal) return;

    const openButtons = document.querySelectorAll("[data-open-dispatch]");
    const closeButtons = modal.querySelectorAll("[data-close-dispatch]");
    const filterButtons = modal.querySelectorAll("[data-dispatch-filter]");
    const taskCards = modal.querySelectorAll("[data-status-key]");

    const toggleModal = (open) => {
      modal.classList.toggle("active", open);
      document.body.classList.toggle("dispatch-modal-open", open);
    };

    openButtons.forEach((button) => {
      button.addEventListener("click", () => toggleModal(true));
    });

    closeButtons.forEach((button) => {
      button.addEventListener("click", () => toggleModal(false));
    });

    modal.addEventListener("click", (event) => {
      if (event.target === modal) {
        toggleModal(false);
      }
    });

    const applyFilter = (targetKey) => {
      filterButtons.forEach((button) => {
        const key = button.getAttribute("data-dispatch-filter");
        const isActive = key === targetKey;
        if (isActive) {
          button.classList.add("active");
        } else {
          button.classList.remove("active");
        }
      });

      taskCards.forEach((card) => {
        const statusKey = card.getAttribute("data-status-key") || "all";
        if (targetKey === "all" || statusKey === targetKey) {
          card.removeAttribute("hidden");
        } else {
          card.setAttribute("hidden", "true");
        }
      });
    };

    filterButtons.forEach((button) => {
      button.addEventListener("click", () => {
        const selected = button.getAttribute("data-dispatch-filter") || "all";
        applyFilter(selected);
      });
    });

    applyFilter(fallbackFilterKey);
  })();
</script>

<script is:inline>
  function handleRecall(event) {
    const taskId = event.target.dataset.taskId;
    const recallErrorBar = document.getElementById('recallErrorBar');
    const recallSuccessBar = document.getElementById('recallSuccessBar');

    if(!taskId){
      return;
    }
    try {
      const dialog = document.getElementById('recallDialog');
      if (!dialog || !dialog.show) {
        if (recallErrorBar) {
          recallErrorBar.show();
          recallErrorBar.textContent = '对话框组件未找到';
        } else {
          alert('对话框组件未找到');
        }
      }
      dialog.show({
        message: '撤销任务后，任务下的所有数据将无法恢复，是否继续撤销？',
        onConfirm: async () => {
          const response = await fetch('/taskApi/taskorder/deleteHall', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id: taskId })
          });

          if(response.ok){
            if(response.status === 200){
              const res = await response.json();
              if(res.code === 1){
                // 处理成功逻辑
                if(recallSuccessBar){
                  recallSuccessBar.show();
                  recallSuccessBar.textContent = '撤销成功';
                }else{
                  alert('撤销成功');
                }
                window.location.reload();
              }else{
                if(recallErrorBar){
                  recallErrorBar.show();
                  recallErrorBar.textContent = res.msg || res.message || "撤销任务失败，请重试";
                }else{
                  alert(res.msg || res.message || "撤销任务失败，请重试");
                }
              }
            }else{
              if(recallErrorBar){
                recallErrorBar.show();
                recallErrorBar.textContent = '撤销任务失败，请重试';
              }else{
                alert('撤销任务失败，请重试');
              }
            }
          }
        },
        onCancel: () => {
          console.log('用户点击了取消');
        }
      });
    } catch(err){
        console.log("🚀 ~ handleRecall ~ err: ", err);
    }
  }
  function handleDetail(event) {
    const taskId = event.target.dataset.taskId;
    if (!taskId) {
      return;
    }
    let projectPerformanceInfo= window.__projectPerformanceInfo__.find(item => '' + item.id === taskId);
    sessionStorage.setItem("projectPerformanceDetailInfo", JSON.stringify(projectPerformanceInfo));
    sessionStorage.setItem("projectDetailInfo", JSON.stringify(window.__projectDetail__));
    window.location.href = `/project-task-detail/${taskId}`;
  }
</script>
