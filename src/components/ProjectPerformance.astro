  }

  .execution-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .execution-stage {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .stage-name {
    font-size: 16px;
    font-weight: 700;
    color: #0f172a;
  }

  .stage-type {
    display: inline-flex;
    font-size: 12px;
    padding: 2px 8px;
    border-radius: 999px;
    background: #eff6ff;
    color: #2563eb;
  }

  .execution-status {
    text-align: right;
    display: flex;
    flex-direction: column;
    gap: 6px;
      box-shadow: none;
  }

  .status-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 4px 10px;
    border-radius: 999px;
