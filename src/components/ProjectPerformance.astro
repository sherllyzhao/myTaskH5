---

---
<div class="detail-card">
	<div class="section-title">⚡ 执行信息</div>
	<div class="execution-list">
		<!-- 设计任务 -->
		<div class="execution-item">
			<div class="execution-header">
				<div class="execution-type">
					<span class="execution-status status-设计">🎨 设计</span>
				</div>
				<div class="execution-amount">¥ 0.00</div>
			</div>
			<div class="execution-details">
				<div class="execution-detail">
					<span class="info-label">📅 发布时间</span>
					<span class="execution-detail-value"
					>2024-12-28<br />09:13:42</span
					>
				</div>
				<div class="execution-detail">
					<span class="info-label">📤 验收时间</span>
					<span class="execution-detail-value">未上传</span>
				</div>
				<div class="execution-detail">
					<span class="info-label">🔍 状态</span>
					<span class="execution-detail-value">未审核</span>
				</div>
				<div class="execution-detail">
					<span class="info-label">🔗 功能地址</span>
					<span class="execution-detail-value">1</span>
				</div>
			</div>
			<div class="execution-actions">
				<div class="execution-satisfaction">
					<span>满意度:</span>
					<span class="satisfaction-stars">-</span>
				</div>
				<button class="execution-action-btn">新增</button>
			</div>
		</div>

		<!-- 网站制作任务 -->
		<div class="execution-item">
			<div class="execution-header">
				<div class="execution-type">
								<span class="execution-status status-网站制作"
								>💻 网站制作</span
								>
				</div>
				<div class="execution-amount">¥ 0.50</div>
			</div>
			<div class="execution-details">
				<div class="execution-detail">
					<span class="info-label">👤 申请人</span>
					<span class="execution-detail-value">资海云</span>
				</div>
				<div class="execution-detail">
					<span class="info-label">📅 发布时间</span>
					<span class="execution-detail-value"
					>2024-11-04<br />10:00:59</span
					>
				</div>
				<div class="execution-detail">
					<span class="info-label">📤 验收时间</span>
					<span class="execution-detail-value"
					>2024-11-04<br />10:42:39</span
					>
				</div>
				<div class="execution-detail">
					<span class="info-label">🔍 状态</span>
					<span class="execution-detail-value">
								<span class="execution-status status-已验收"
								>✅ 已验收</span
								>
								</span>
				</div>
				<div class="execution-detail">
					<span class="info-label">🔗 功能地址</span>
					<span class="execution-detail-value">停生查看</span>
				</div>
				<div class="execution-detail">
					<span class="info-label">📝 验收情况</span>
					<span class="execution-detail-value">排权关</span>
				</div>
				<div class="execution-detail">
					<span class="info-label">⏰ 完成时间</span>
					<span class="execution-detail-value"
					>2024-11-04<br />10:53:15</span
					>
				</div>
				<div class="execution-detail">
					<span class="info-label">🔍 审核时间</span>
					<span class="execution-detail-value">-</span>
				</div>
			</div>
			<div class="execution-actions">
				<div class="execution-satisfaction">
					<span>满意度:</span>
					<span class="satisfaction-stars">⭐</span>
					<span>1</span>
				</div>
				<button class="execution-action-btn">新增</button>
			</div>
		</div>
	</div>
</div>
