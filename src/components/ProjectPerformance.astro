---
import { Debug } from 'astro/components';
import {getAddCommission, getBaseCommission, isLeave} from "../utils/map.ts";
import {formatTimestamp} from "../utils/tool.ts";
import ExecutionDetailDrawer from "./ExecutionDetailDrawer.astro";

interface Props {
  data?: Record<string, any>;
}

type AnyRecord = Record<string, any>;

const { data }: Props = Astro.props;

const proxyUrl = `${Astro.url.origin}/proxy`;
let projectPerformanceInfo: any[] = [];
let page = 1;
let limit = 100;

async function getPerformanceList(){
  try{
    if(!data || !data.id) return
    const response = await fetch(proxyUrl, {
      method: "POST",
      headers: {
        "Content-Type": "application/json",
        "Cookie": Astro.request.headers.get("cookie") || "",
      },
      body: JSON.stringify({
        path: "/taskorder/getHallShow", // 假设这是获取用户信息的接口路径，请根据实际情况修改
        id: data.id,
        limit: limit,
        page: page
      }),
    })

    if (response.status === 200) {
      const res = await response.json();
      if (res.code === 1) {
        projectPerformanceInfo = projectPerformanceInfo.concat(...res.data.data);
        if(res.last_page > limit){
          page ++;
          await getPerformanceList();
        }
      }
    }
  }catch (e) {
    console.log(e)
  }
}
await getPerformanceList()

const pickArray = (source: AnyRecord | undefined | null, keys: string[]) => {
  if (!source) return [];
  for (const key of keys) {
    const value = source[key];
    if (Array.isArray(value) && value.length) {
      return value;
    }
  }
  for (const key of keys) {
    const value = source[key];
    if (Array.isArray(value)) {
      return value;
    }
  }
  return [];
};

const normalizeStatusMeta = (status?: string) => {
  const value = (status || "").toLowerCase();
  if (!status) {
    return { className: "status-default", key: "unknown" };
  }
  if (/(完成|验收|通过|生效|success|done)/.test(status)) {
    return { className: "status-success", key: "done" };
  }
  if (/(驳回|失败|关闭|拒绝|reject|refuse|cancel)/.test(status)) {
    return { className: "status-danger", key: "rejected" };
  }
  if (/(待|未|排队|pending|todo)/.test(status)) {
    return { className: "status-pending", key: "pending" };
  }
  if (/(暂停|挂起|hold)/.test(status)) {
    return { className: "status-offline", key: "paused" };
  }
  if (/(进行|处理中|执行|开发|design|制作)/.test(value)) {
    return { className: "status-info", key: "in-progress" };
  }
  return { className: "status-default", key: "unknown" };
};

const auditStatusMetaMap: Record<number, { label: string; className: string }> = {
  0: { label: "待审核", className: "status-pending" },
  1: { label: "已通过", className: "status-success" },
  2: { label: "已驳回", className: "status-danger" },
};

const getAuditStatusMeta = (status?: number | string | null) => {
  if (status === undefined || status === null || status === "") {
    return null;
  }
  const parsed = Number(status);
  if (Number.isNaN(parsed)) {
    return null;
  }
  return auditStatusMetaMap[parsed] || null;
};

const toArrayFromCsv = (value: any): string[] => {
  if (Array.isArray(value)) {
    return value
      .map((item) => (item === undefined || item === null ? "" : String(item).trim()))
      .filter(Boolean);
  }
  if (typeof value === "string") {
    const trimmed = value.trim();
    if (!trimmed) return [];
    if (/^\[.*\]$/.test(trimmed)) {
      try {
        const parsed = JSON.parse(trimmed);
        if (Array.isArray(parsed)) {
          return parsed.map((item) => (item === undefined || item === null ? "" : String(item).trim())).filter(Boolean);
        }
      } catch {
        // ignore parse errors and fallback to CSV split
      }
    }
    return trimmed.split(",").map((item) => item.trim()).filter(Boolean);
  }
  if (value !== undefined && value !== null) {
    const text = String(value).trim();
    return text ? [text] : [];
  }
  return [];
};

const normalizeFileListValue = (
  value: any,
): { fileurl: string; filename: string }[] => {
  if (value === undefined || value === null || value === "") {
    return [];
  }
  if (typeof value === "string") {
    const trimmed = value.trim();
    if (!trimmed) return [];
    if (trimmed.startsWith("[") && trimmed.endsWith("]")) {
      try {
        const parsed = JSON.parse(trimmed);
        return normalizeFileListValue(parsed);
      } catch {
        // ignore parse errors and fallback to CSV split
      }
    }
    return trimmed
      .split(",")
      .map((item) => item.trim())
      .filter(Boolean)
      .map((url) => ({
        fileurl: url,
        filename: url.split("/").pop() || "附件",
      }));
  }
  if (Array.isArray(value)) {
    return value
      .map((item) => {
        if (item === undefined || item === null) return null;
        if (typeof item === "string") {
          const trimmed = item.trim();
          if (!trimmed) return null;
          return {
            fileurl: trimmed,
            filename: trimmed.split("/").pop() || "附件",
          };
        }
        if (typeof item === "object") {
          const fileurl = String(item.fileurl || item.url || item.path || item.href || "").trim();
          if (!fileurl) {
            return null;
          }
          const filename =
            item.filename ||
            item.name ||
            item.title ||
            fileurl.split("/").pop() ||
            "附件";
          return { fileurl, filename };
        }
        return null;
      })
      .filter(Boolean) as { fileurl: string; filename: string }[];
  }
  if (typeof value === "object") {
    const fileurl = String(value.fileurl || value.url || value.path || value.href || "").trim();
    if (!fileurl) return [];
    return [
      {
        fileurl,
        filename: value.filename || value.name || fileurl.split("/").pop() || "附件",
      },
    ];
  }
  return [];
};

const buildAppendlogDetailEntries = (appendlog?: AnyRecord | null, fallbackAddress?: string) => {
  if (!appendlog && !fallbackAddress) {
    return [];
  }
  const annexList = appendlog ? toArrayFromCsv(appendlog.annex ?? appendlog.link ?? appendlog.address) : [];
  if (!annexList.length && fallbackAddress) {
    annexList.push(fallbackAddress);
  }
  const usernameList = toArrayFromCsv(appendlog?.username ?? appendlog?.user);
  const passwordList = toArrayFromCsv(appendlog?.password);
  const remarkList = toArrayFromCsv(appendlog?.description ?? appendlog?.remark);
  const entryCount = Math.max(annexList.length, usernameList.length, passwordList.length, 1);
  if (!appendlog && !entryCount) {
    return [];
  }
  const getValue = (list: string[], index: number) => {
    if (!list.length) return "";
    return list[index] ?? list[list.length - 1] ?? "";
  };

  const fileList = normalizeFileListValue(appendlog?.filelist);

  return Array.from({ length: entryCount }).map((_, index) => ({
    annex: getValue(annexList, index),
    username: getValue(usernameList, index),
    password: getValue(passwordList, index),
    remark: getValue(remarkList, index) || appendlog?.description || appendlog?.remark || "",
    statustxt: appendlog?.statustxt ?? "",
    status: appendlog?.status ?? "",
    audittime: appendlog?.audittime ?? "",
    createtime: appendlog?.createtime ?? "",
    filelist: fileList,
  }));
};

const formatAmountLabel = (value: any) => {
  if (value === null || value === undefined || value === "") {
    return "¥ 0.00";
  }
  if (typeof value === "number") {
    return `¥ ${value.toFixed(2)}`;
  }
  const parsed = Number(value);
  if (!Number.isNaN(parsed)) {
    return `¥ ${parsed.toFixed(2)}`;
  }
  const text = String(value);
  return /^¥/.test(text) ? text : `¥ ${text}`;
};

const normalizeExecution = (item: AnyRecord, index: number) => {
  const stageName = item.stage || item.stageName || item.name || `执行阶段 ${index + 1}`;
  const stageType = item.stageType || item.type || item.taskType || item.category || "";
  const statusText = item.statusText || item.statustxt || item.status || "进行中";
  const statusMeta = normalizeStatusMeta(statusText);
  const rawAddress = item.address || item.functionAddress || item.link || item.annex || "";

  return {
    id: item.id ?? item.stageId ?? index,
    stageName,
    stageType,
    amountLabel: formatAmountLabel(item.amount ?? item.money ?? item.reward ?? item.fee ?? 0),
    publishTime: item.publishTime ?? item.createTime ?? item.createtime ?? item.orderTime ?? "-",
    reviewTime: item.reviewTime ?? item.auditTime ?? item.audittime ?? "-",
    applicant: item.applicant ?? item.customer ?? item.username ?? "",
    reviewer: item.reviewer ?? item.auditUser ?? item.handler ?? "",
    functionAddress: rawAddress || "-",
    functionLink: typeof rawAddress === "string" && /^https?:\/\//i.test(rawAddress) ? rawAddress : "",
    statusText,
    statusClass: statusMeta.className,
    statusKey: statusMeta.key,
    satisfactionLabel: item.satisfaction ?? item.satisfactionLevel ?? "-",
    satisfactionScore: item.satisfactionScore ?? item.satisfactionStars ?? "",
    remark: item.remark ?? item.description ?? "",
  };
};

const normalizeDispatchTask = (item: AnyRecord, index: number) => {
  const statusText = item.statusText ?? item.status ?? "进行中";
  const statusMeta = normalizeStatusMeta(statusText);

  return {
    id: item.id ?? item.taskId ?? index,
    name: item.name ?? item.title ?? `子任务 ${index + 1}`,
    module: item.module ?? item.groupName ?? item.category ?? "执行模块",
    type: item.type ?? item.taskType ?? "",
    publishTime: item.publishTime ?? item.createTime ?? item.createtime ?? "-",
    deadline: item.deadline ?? item.endTime ?? item.expectTime ?? "-",
    owner: item.owner ?? item.executor ?? item.username ?? "",
    amountLabel: formatAmountLabel(item.amount ?? item.money ?? item.reward ?? "-"),
    description: item.description ?? item.remark ?? "",
    statusText,
    statusKey: statusMeta.key,
    statusClass: statusMeta.className,
  };
};

const executionCandidates = pickArray(data, [
  "projectExecutions",
  "executionList",
  "projectExecutionList",
  "executionlist",
  "stageList",
  "projectLogList",
  "projectLog",
]);

const dispatchCandidates = pickArray(data, [
  "dispatchTasks",
  "issueTaskList",
  "issueTasks",
  "projectIssueList",
  "taskIssueList",
  "pendingIssueList",
]);

const fallbackExecutions = [
  {
    id: "stage-fallback-1",
    stageName: "方案梳理",
    stageType: "需求设计",
    amountLabel: "¥ 0.00",
    publishTime: "2024-12-28 09:13:42",
    reviewTime: "未上传",
    applicant: "李设计",
    reviewer: "-",
    functionAddress: "功能清单 V1",
    functionLink: "",
    statusText: "未审核",
    statusClass: "status-pending",
    statusKey: "pending",
    satisfactionLabel: "-",
    satisfactionScore: "-",
    remark: "等待客户提供最终资料。",
  },
  {
    id: "stage-fallback-2",
    stageName: "网站制作",
    stageType: "开发交付",
    amountLabel: "¥ 0.50",
    publishTime: "2024-11-04 10:00:59",
    reviewTime: "2024-11-04 10:53:15",
    applicant: "资海云",
    reviewer: "项目经理",
    functionAddress: "投产查看",
    functionLink: "",
    statusText: "已验收",
    statusClass: "status-success",
    statusKey: "done",
    satisfactionLabel: "评分",
    satisfactionScore: "1",
    remark: "客户反馈良好，准备上线。",
  },
];

const fallbackDispatchTasks = [
  {
    id: "dispatch-fallback-1",
    name: "首页 Banner 设计",
    module: "UI / 视觉",
    type: "设计",
    publishTime: "2024-11-05 09:00",
    deadline: "2024-11-05 18:00",
    owner: "张三",
    amountLabel: "¥ 300.00",
    description: "输出两版视觉稿，保留编辑源文件。",
    statusText: "进行中",
    statusKey: "in-progress",
    statusClass: "status-info",
  },
  {
    id: "dispatch-fallback-2",
    name: "功能架构整理",
    module: "产品",
    type: "规划",
    publishTime: "2024-11-02 10:20",
    deadline: "2024-11-03 17:30",
    owner: "李四",
    amountLabel: "¥ 420.00",
    description: "梳理 PC + 移动端交互流程，标记接口。",
    statusText: "待接收",
    statusKey: "pending",
    statusClass: "status-pending",
  },
  {
    id: "dispatch-fallback-3",
    name: "上线巡检",
    module: "交付",
    type: "验收",
    publishTime: "2024-10-30 09:30",
    deadline: "2024-10-31 10:00",
    owner: "王工",
    amountLabel: "¥ 180.00",
    description: "检查 SSL、404 页面以及主流浏览器兼容性。",
    statusText: "已完成",
    statusKey: "done",
    statusClass: "status-success",
  },
];

const executionList =
  executionCandidates.length > 0
    ? executionCandidates.map(normalizeExecution)
    : fallbackExecutions;

const dispatchTaskList =
  dispatchCandidates.length > 0
    ? dispatchCandidates.map(normalizeDispatchTask)
    : fallbackDispatchTasks;

const fallbackInProgressCount =
  executionList.filter((item) => item.statusKey === "in-progress").length || 0;

const fallbackDoneCount =
  executionList.filter((item) => item.statusKey === "done").length || 0;

const fallbackSatisfactionText = executionList.length ? "良好" : "-";

const statusMap = projectPerformanceInfo.reduce<Record<string, number>>((acc, item) => {
  acc[item.statusInfo] = (acc[item.statusInfo] || 0) + 1;
  return acc;
}, {});

const summaryStats = Object.entries(statusMap).map(([label, value]) => ({ label, value }));

const dispatchFilterOptions = [
  { key: "all", label: "全部" },
  { key: "in-progress", label: "进行中" },
  { key: "pending", label: "待接收" },
  { key: "done", label: "已完成" },
];

const defaultFilterKey = dispatchFilterOptions[0]?.key ?? "all";
const modalId = "project-dispatch-modal";
const detailModalId = "execution-detail-modal";
---

<div class="detail-card project-performance-card">
  <div class="section-top">
    <div>
      <div class="section-title">⚡ 执行信息</div>
    </div>
    <button class="dispatch-btn" type="button" data-open-dispatch>下发任务</button>
  </div>

    <!--<Debug data={projectPerformanceInfo} />-->

  <div class="summary-grid">
    {summaryStats.map((stat) => (
      <div class="summary-item">
        <div class="summary-label">{stat.label}</div>
        <div class="summary-value">{stat.value}</div>
      </div>
    ))}
  </div>

  <div class="execution-mobile-list">
    {projectPerformanceInfo.length > 0 ? (
      projectPerformanceInfo.map((stage) => {
        const auditStatusMeta = getAuditStatusMeta(stage?.appendlog?.status);

        return (
        <div class="execution-card" data-status-key={stage.statusInfo}>
          <div class="execution-card-header">
            <div class="execution-stage">
              <span class="stage-name">{stage.hallTypeTitle}</span>
            </div>
            <div class="execution-status">
              <span class={`task-badge status-${stage.statusInfo}`}>{stage.statusInfo}</span>
            </div>
          </div>

          <div class="execution-card-body">
            <div class="meta-row">
              <span class="meta-label">申请人</span>
              <span class="meta-value">
                {stage?.userlist[0]?.username ?? "-"}
                {
                  isLeave(stage) && <span class="meta-tag meta-tag-leave">已离职</span>
                }
              </span>
            </div>
            <div class="meta-row">
              <span class="meta-label">下发人</span>
              <span class="meta-value">{stage.username || "-"}</span>
            </div>
            <div class="meta-row">
              <span class="meta-label">基础佣金</span>
              <span class="meta-value">￥{getBaseCommission(stage) || "-"}</span>
            </div>
            <div class="meta-row">
              <span class="meta-label">加价佣金</span>
              <span class="meta-value">￥{getAddCommission(stage) || "-"}</span>
            </div>
            <div class="meta-row">
              <span class="meta-label">发布时间</span>
              <span class="meta-value">{stage.createtime || "-"}</span>
            </div>
            <div class="meta-row">
              <span class="meta-label">接单时间</span>
              <span class="meta-value">{formatTimestamp(stage.performtime) || "-"}</span>
            </div>
            <div class="meta-row">
                <span class="meta-label">完成时间</span>
                <span class="meta-value">{stage.appendlog?.createtime || "-"}</span>
            </div>
            <div class="meta-row">
              <span class="meta-label">审核时间</span>
              <span class="meta-value">{stage?.appendlog?.audittime || "-"}</span>
            </div>
            <div class="meta-row">
              <span class="meta-label">验收情况</span>
              <span class="meta-value">
                {auditStatusMeta && (
                  <span class={`status-badge audit-status-badge ${auditStatusMeta.className}`}>
                    {auditStatusMeta.label}
                  </span>
                )}
              </span>
            </div>
            <div class="meta-row">
              <span class="meta-label">功能地址</span>
              <span class="meta-value">
                {stage.appendlog && (
		                <button
				                class="view-detail-btn"
				                type="button"
				                data-open-execution-detail
				                data-execution-data={JSON.stringify(buildAppendlogDetailEntries(stage.appendlog, stage.functionAddress))}
		                >
			                查看
		                </button>
                )}
              </span>
            </div>
          </div>

          {stage.remark && <div class="execution-remark">{stage.remark}</div>}

          <div class="execution-card-footer">
            <div class="satisfaction">
              <span class="meta-label">满意度</span>
              <span class="satisfaction-score">
                {stage.satisfactionScore || stage.satisfactionLabel || "-"}
              </span>
            </div>
            <button class="ghost-btn" type="button">记录进度</button>
          </div>
        </div>
        );
      })
    ) : (
      <div class="empty-state">
        <div class="empty-icon">🗂️</div>
        <div class="empty-title">暂未创建执行阶段</div>
        <p class="empty-desc">点击右上角「下发任务」即可新建阶段</p>
      </div>
    )}
  </div>
</div>

<div class="dispatch-modal" id={modalId} aria-hidden="true" role="dialog">
  <div class="dispatch-modal-content">
    <div class="dispatch-modal-header">
      <div>
        <div class="modal-title">任务下发</div>
        <p class="modal-desc">选择子任务并同步给执行人</p>
      </div>
      <button class="modal-close" type="button" data-close-dispatch aria-label="关闭弹窗">×</button>
    </div>

    <div class="dispatch-filter-list">
      {dispatchFilterOptions.map((filter, index) => (
        <button
          class={`dispatch-filter-btn ${index === 0 ? "active" : ""}`}
          type="button"
          data-dispatch-filter={filter.key}
        >
          {filter.label}
        </button>
      ))}
    </div>

    <div class="dispatch-task-list">
      {dispatchTaskList.length > 0 ? (
        dispatchTaskList.map((task) => (
          <div class="dispatch-task-card" data-status-key={task.statusKey}>
            <div class="task-card-header">
              <div>
                <div class="task-title">{task.name}</div>
                <div class="task-module">
                  {task.module}
                  {task.type ? ` · ${task.type}` : ""}
                </div>
              </div>
              <span class={`status-badge ${task.statusClass}`}>{task.statusText}</span>
            </div>

            <div class="task-meta-grid">
              <div class="meta-row">
                <span class="meta-label">执行人</span>
                <span class="meta-value">{task.owner || "-"}</span>
              </div>
              <div class="meta-row">
                <span class="meta-label">发布时间</span>
                <span class="meta-value">{task.publishTime || "-"}</span>
              </div>
              <div class="meta-row">
                <span class="meta-label">截止时间</span>
                <span class="meta-value">{task.deadline || "-"}</span>
              </div>
              <div class="meta-row">
                <span class="meta-label">预算</span>
                <span class="meta-value">{task.amountLabel || "-"}</span>
              </div>
            </div>

            {task.description && <div class="task-description">{task.description}</div>}

            <div class="task-actions">
              <button class="ghost-btn ghost-small" type="button">查看要求</button>
              <button class="primary-btn" type="button">立即下发</button>
            </div>
          </div>
        ))
      ) : (
        <div class="empty-state small">
          <div class="empty-icon">📝</div>
          <div class="empty-title">暂无可下发的任务</div>
          <p class="empty-desc">前往后台创建执行内容后即可在此推送。</p>
        </div>
      )}
    </div>
  </div>
</div>

<ExecutionDetailDrawer />

<style>
  :global(body.dispatch-modal-open) {
    overflow: hidden;
  }

  .project-performance-card {
    border-radius: 20px;
    padding: 20px 16px;
    background: #ffffff;
    box-shadow: 0 8px 30px rgba(15, 23, 42, 0.08);
    border: 1px solid #e2e8f0;
  }

  .section-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .section-title {
    font-size: 16px;
    font-weight: 700;
    color: #0f172a;
  }

  .section-subtitle {
    font-size: 12px;
    color: #94a3b8;
    margin-top: 4px;
  }

  .dispatch-btn {
    border: none;
    border-radius: 999px;
    padding: 10px 18px;
    font-size: 14px;
    font-weight: 600;
    color: #ffffff;
    background: linear-gradient(120deg, #2563eb, #4c1d95);
    box-shadow: 0 8px 20px rgba(37, 99, 235, 0.35);
    cursor: pointer;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .dispatch-btn:active {
    transform: scale(0.97);
    box-shadow: 0 4px 10px rgba(37, 99, 235, 0.35);
  }

  .summary-grid {
    margin-top: 16px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(100px, 1fr));
    gap: 12px;
  }

  .summary-item {
    padding: 12px;
    border-radius: 16px;
    background: linear-gradient(180deg, #f8fafc 0%, #f1f5f9 100%);
    border: 1px solid #e2e8f0;
  }

  .summary-label {
    font-size: 12px;
    color: #94a3b8;
    margin-bottom: 4px;
  }

  .summary-value {
    font-size: 20px;
    font-weight: 700;
    color: #0f172a;
  }

  .execution-mobile-list {
    margin-top: 16px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .execution-card {
    border-radius: 18px;
    border: 1px solid #e2e8f0;
    background: #ffffff;
    padding: 16px;
    box-shadow: 0 4px 16px rgba(15, 23, 42, 0.06);
  }

  .execution-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

