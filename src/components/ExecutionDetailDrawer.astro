---
/**
 * 执行详情抽屉组件（只读模式）
 * 用法：在 ProjectPerformance.astro 中引入此组件
 *
 * 在功能地址那行添加查看按钮：
 * {stage.appendlog && (
 *   <button
 *     class="view-detail-btn"
 *     type="button"
 *     data-open-execution-detail
 *     data-execution-data={JSON.stringify(buildAppendlogDetailEntries(stage.appendlog, stage.functionAddress))}
 *   >
 *     查看
 *   </button>
 * )}
 */
---

<!-- 执行详情抽屉 -->
<div class="execution-detail-drawer" id="execution-detail-drawer" aria-hidden="true">
  <div class="drawer-overlay" data-close-execution-detail></div>
  <div class="drawer-content">
    <div class="drawer-header">
      <h3 class="drawer-title">执行信息详情</h3>
      <button class="drawer-close" type="button" data-close-execution-detail aria-label="关闭抽屉">×</button>
    </div>
    <div class="drawer-body" id="execution-detail-body">
      <!-- 内容由 JS 动态填充 -->
    </div>
  </div>
</div>

<style>
  /* 抽屉遮罩层 */
  .execution-detail-drawer {
    position: fixed;
    inset: 0;
    z-index: 1000;
    visibility: hidden;
    pointer-events: none;
  }

  .execution-detail-drawer.active {
    visibility: visible;
    pointer-events: auto;
  }

  .drawer-overlay {
    position: absolute;
    inset: 0;
    background: rgba(15, 23, 42, 0.55);
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .execution-detail-drawer.active .drawer-overlay {
    opacity: 1;
  }

  /* 抽屉内容 */
  .drawer-content {
    position: absolute;
    right: 0;
    top: 0;
    bottom: 0;
    width: 100%;
    max-width: 420px;
    background: #ffffff;
    box-shadow: -8px 0 30px rgba(15, 23, 42, 0.15);
    transform: translateX(100%);
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    display: flex;
    flex-direction: column;
  }

  .execution-detail-drawer.active .drawer-content {
    transform: translateX(0);
  }

  /* 抽屉头部 */
  .drawer-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 20px;
    border-bottom: 1px solid #e2e8f0;
    background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
  }

  .drawer-title {
    font-size: 18px;
    font-weight: 700;
    color: #0f172a;
    margin: 0;
  }

  .drawer-close {
    border: none;
    background: #f1f5f9;
    border-radius: 999px;
    width: 32px;
    height: 32px;
    font-size: 20px;
    line-height: 1;
    cursor: pointer;
    color: #64748b;
    transition: all 0.2s ease;
  }

  .drawer-close:hover {
    background: #e2e8f0;
    color: #0f172a;
  }

  /* 抽屉主体 */
  .drawer-body {
    flex: 1;
    overflow-y: auto;
    padding: 20px;
  }

  /* 执行信息组样式（只读） */
  :global(.execution-detail-group) {
    margin-bottom: 20px;
    padding: 16px;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    background: linear-gradient(135deg, #fafafa 0%, #f5f5f5 100%);
  }

  :global(.execution-detail-group-title) {
    font-size: 15px;
    font-weight: 600;
    color: #1e293b;
    margin-bottom: 12px;
    padding-bottom: 8px;
    border-bottom: 1px solid #e2e8f0;
  }

  :global(.execution-detail-row) {
    display: flex;
    margin-bottom: 10px;
    font-size: 14px;
  }

  :global(.execution-detail-row:last-child) {
    margin-bottom: 0;
  }

  :global(.execution-detail-label) {
    color: #64748b;
    min-width: 80px;
    flex-shrink: 0;
  }

  :global(.execution-detail-value) {
    color: #1e293b;
    flex: 1;
    word-break: break-all;
  }

  :global(.execution-detail-value a) {
    color: #2563eb;
    text-decoration: none;
  }

  :global(.execution-detail-value a:hover) {
    text-decoration: underline;
  }

  /* 可复制的值容器 */
  :global(.execution-detail-copyable) {
    display: flex;
    align-items: center;
    gap: 8px;
    flex: 1;
  }

  :global(.execution-detail-copyable-text) {
    flex: 1;
    word-break: break-all;
  }

  :global(.execution-detail-copy-btn) {
    flex-shrink: 0;
    border: none;
    background: #f1f5f9;
    color: #64748b;
    padding: 4px 8px;
    border-radius: 4px;
    font-size: 12px;
    cursor: pointer;
    transition: all 0.2s ease;
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  :global(.execution-detail-copy-btn:hover) {
    background: #e2e8f0;
    color: #334155;
  }

  :global(.execution-detail-copy-btn.copied) {
    background: #dcfce7;
    color: #16a34a;
  }

  /* 附件预览区域 */
  :global(.execution-detail-files) {
    margin-top: 16px;
    padding: 12px;
    background: #f8fafc;
    border-radius: 8px;
    border: 1px solid #e2e8f0;
  }

  :global(.execution-detail-files-title) {
    font-size: 13px;
    font-weight: 600;
    color: #475569;
    margin-bottom: 10px;
  }

  :global(.execution-detail-file-list) {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  :global(.execution-detail-file-item) {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    text-decoration: none;
    max-width: 80px;
  }

  :global(.execution-detail-file-item img) {
    width: 60px;
    height: 60px;
    object-fit: cover;
    border-radius: 6px;
    border: 1px solid #e2e8f0;
  }

  :global(.execution-detail-file-name) {
    font-size: 11px;
    color: #64748b;
    max-width: 80px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    text-align: center;
  }

  /* 备注区域 */
  :global(.execution-detail-remark) {
    margin-top: 16px;
    padding: 12px;
    background: #fffbeb;
    border-radius: 8px;
    border: 1px solid #fde68a;
  }

  :global(.execution-detail-remark-header) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 6px;
  }

  :global(.execution-detail-remark-title) {
    font-size: 13px;
    font-weight: 600;
    color: #92400e;
  }

  :global(.execution-detail-remark-text) {
    font-size: 14px;
    color: #78350f;
    line-height: 1.5;
  }

  /* 空状态 */
  :global(.execution-detail-empty) {
    text-align: center;
    padding: 40px 20px;
    color: #94a3b8;
  }

  :global(.execution-detail-empty-icon) {
    font-size: 48px;
    margin-bottom: 12px;
  }

  :global(.execution-detail-empty-text) {
    font-size: 14px;
  }

  /* 查看按钮样式（需要添加到 ProjectPerformance.astro 的 style 中） */
  :global(.view-detail-btn) {
    border: none;
    background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
    color: #ffffff;
    padding: 4px 10px;
    border-radius: 6px;
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
    margin-left: 8px;
  }

  :global(.view-detail-btn:hover) {
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(37, 99, 235, 0.35);
  }

  :global(.view-detail-btn:active) {
    transform: scale(0.97);
  }

  /* 防止 body 滚动 */
  :global(body.drawer-open) {
    overflow: hidden;
  }

  /* 移动端适配 */
  @media (max-width: 480px) {
    .drawer-content {
      max-width: 100%;
    }
  }
</style>

<script>
  // 执行详情抽屉交互逻辑
  (() => {
    const drawer = document.getElementById('execution-detail-drawer');
    const drawerBody = document.getElementById('execution-detail-body');

    if (!drawer || !drawerBody) return;

    // 打开抽屉
    const openDrawer = (data: any[]) => {
      drawer.classList.add('active');
      document.body.classList.add('drawer-open');
      renderContent(data);
    };

    // 关闭抽屉
    const closeDrawer = () => {
      drawer.classList.remove('active');
      document.body.classList.remove('drawer-open');
    };

    // 渲染内容
    const renderContent = (data: any[]) => {
      if (!data || data.length === 0) {
        drawerBody.innerHTML = `
          <div class="execution-detail-empty">
            <div class="execution-detail-empty-icon">📋</div>
            <div class="execution-detail-empty-text">暂无执行信息</div>
          </div>
        `;
        return;
      }

      let html = '';

      data.forEach((item, index) => {
        html += `
          <div class="execution-detail-group">
            <div class="execution-detail-group-title">执行信息 ${index + 1}</div>

            <div class="execution-detail-row">
              <span class="execution-detail-label">附件地址</span>
              <span class="execution-detail-value">
                ${item.annex ? `
                  <span class="execution-detail-copyable">
                    <a href="${item.annex}" target="_blank" rel="noopener" class="execution-detail-copyable-text">${item.annex}</a>
                    <button class="execution-detail-copy-btn" data-copy="${item.annex}" type="button">复制</button>
                  </span>
                ` : '-'}
              </span>
            </div>

            <div class="execution-detail-row">
              <span class="execution-detail-label">账号</span>
              <span class="execution-detail-value">
                ${item.username ? `
                  <span class="execution-detail-copyable">
                    <span class="execution-detail-copyable-text">${item.username}</span>
                    <button class="execution-detail-copy-btn" data-copy="${item.username}" type="button">复制</button>
                  </span>
                ` : '-'}
              </span>
            </div>

            <div class="execution-detail-row">
              <span class="execution-detail-label">密码</span>
              <span class="execution-detail-value">
                ${item.password ? `
                  <span class="execution-detail-copyable">
                    <span class="execution-detail-copyable-text">${item.password}</span>
                    <button class="execution-detail-copy-btn" data-copy="${item.password}" type="button">复制</button>
                  </span>
                ` : '-'}
              </span>
            </div>

            ${item.createtime ? `
              <div class="execution-detail-row">
                <span class="execution-detail-label">创建时间</span>
                <span class="execution-detail-value">${item.createtime}</span>
              </div>
            ` : ''}

            ${item.audittime ? `
              <div class="execution-detail-row">
                <span class="execution-detail-label">审核时间</span>
                <span class="execution-detail-value">${item.audittime}</span>
              </div>
            ` : ''}

            ${item.filelist && item.filelist.length > 0 ? `
              <div class="execution-detail-files">
                <div class="execution-detail-files-title">📎 附件</div>
                <div class="execution-detail-file-list">
                  ${item.filelist.map((file: any) => `
                    <a class="execution-detail-file-item" href="${file.fileurl}" target="_blank" rel="noopener">
                      <img src="${file.fileurl}" alt="${file.filename}" onerror="this.src='data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 24 24%22 fill=%22%2394a3b8%22><path d=%22M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6z%22/></svg>'" />
                      <span class="execution-detail-file-name" title="${file.filename}">${file.filename}</span>
                    </a>
                  `).join('')}
                </div>
              </div>
            ` : ''}

            ${item.remark ? `
              <div class="execution-detail-remark">
                <div class="execution-detail-remark-header">
                  <span class="execution-detail-remark-title">📝 备注</span>
                  <button class="execution-detail-copy-btn" data-copy="${item.remark.replace(/"/g, '&quot;')}" type="button">复制</button>
                </div>
                <div class="execution-detail-remark-text">${item.remark}</div>
              </div>
            ` : ''}
          </div>
        `;
      });

      drawerBody.innerHTML = html;
    };

    // 复制到剪贴板
    const copyToClipboard = async (text: string, btn: HTMLElement) => {
      try {
        await navigator.clipboard.writeText(text);
        btn.textContent = '已复制';
        btn.classList.add('copied');
        setTimeout(() => {
          btn.textContent = '复制';
          btn.classList.remove('copied');
        }, 2000);
      } catch (err) {
        // 降级方案
        const textarea = document.createElement('textarea');
        textarea.value = text;
        textarea.style.position = 'fixed';
        textarea.style.opacity = '0';
        document.body.appendChild(textarea);
        textarea.select();
        try {
          document.execCommand('copy');
          btn.textContent = '已复制';
          btn.classList.add('copied');
          setTimeout(() => {
            btn.textContent = '复制';
            btn.classList.remove('copied');
          }, 2000);
        } catch (e) {
          console.error('复制失败:', e);
        }
        document.body.removeChild(textarea);
      }
    };

    // 绑定打开按钮事件和复制按钮事件
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;

      // 处理复制按钮
      const copyBtn = target.closest('.execution-detail-copy-btn') as HTMLElement;
      if (copyBtn) {
        const textToCopy = copyBtn.getAttribute('data-copy');
        if (textToCopy) {
          copyToClipboard(textToCopy, copyBtn);
        }
        return;
      }

      // 处理打开抽屉按钮
      const openBtn = target.closest('[data-open-execution-detail]') as HTMLElement;

      if (openBtn) {
        const dataStr = openBtn.getAttribute('data-execution-data');
        if (dataStr) {
          try {
            const data = JSON.parse(dataStr);
            openDrawer(data);
          } catch (err) {
            console.error('解析执行数据失败:', err);
          }
        }
      }
    });

    // 绑定关闭按钮事件
    const closeButtons = drawer.querySelectorAll('[data-close-execution-detail]');
    closeButtons.forEach((btn) => {
      btn.addEventListener('click', closeDrawer);
    });

    // ESC 键关闭
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && drawer.classList.contains('active')) {
        closeDrawer();
      }
    });
  })();
</script>
