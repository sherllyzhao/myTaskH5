---
import AlertBar from "./AlertBar.astro";
import type { FilterItem, FilterGroup } from "../types/filter";

interface Props {
  groups: FilterGroup[];
  canAdd?: boolean;
  onAdd?: () => void;
  onDelete?: () => void;
}

const {groups, canAdd, onAdd, onDelete} = Astro.props;

// 获取选择器的显示标签
const getPickerLabel = (item: FilterItem, value: string | undefined) => {
  if (value && item.options) {
    const option = item.options.find((opt: { value: string; label: string; }) => '' + opt.value === '' + value);
    return option?.label || value;
  }
  return '';
}
---

<!-- 可配置的筛选组件 -->
<div class="filter-container">
  {groups.map((group: FilterGroup) => (
    <div class="filter-section">
      <h4 class="filter-section-title">{group.title}</h4>
      <div class={`filter-grid ${group.items.some((item: FilterItem) => item.width === 'half') ? 'two-cols' : ''}`}>
        {group.items.map((item, index) => {
          const itemClass = `filter-item ${item.width === 'half' ? 'half-width' : 'full-width'}`;

          return (
            <div class={itemClass}>
              <div class="filter-field-wrapper">
                {item.showLabel && item.label && (
                  <label class="filter-field-label">{item.label}</label>
                )}

                <div class="filter-control">
                  <span class="filter-item-icon">{item.icon}</span>

                  {item.type === 'input' ? (
                    <input
                      type="text"
                      class="filter-input"
                      name={item.name}
                      placeholder={item.placeholder || ''}
                      value={item.defaultValue || ''}
                    />
                  ) : item.type === 'number' ? (
                    <input
                    type="number"
                    class="filter-input"
                    name={item.name}
                    placeholder={item.placeholder || ''}
                    value={item.defaultValue || ''}
                    min="0"
                    step="1"
                  />
                ) : item.type === 'file' ? (
                  <div class="file-upload-wrapper">
                    <input
                      type="file"
                      class="file-input"
                      id={`file-${item.name}`}
                      name={item.name}
                      accept={item.accept || '*/*'}
                      onchange="onFileChange(event)"
                    />
                    <label for={`file-${item.name}`} class="file-label">
                      <span class="file-display" data-name={item.name} data-placeholder={item.placeholder || '选择文件'}>
                        {item.placeholder || '选择文件'}
                      </span>
                    </label>
                  </div>
                ) : item.type === 'date-time-picker' ? (
                  <button
                    class="mobile-picker-trigger date-time-picker"
                    type="button"
                    name={item.name}
                    data-picker="date-time"
                    data-value={item.defaultValue || ''}
                    data-placeholder={item.placeholder || '选择日期时间'}
                  >
                    {item.defaultValue || item.placeholder || '选择日期时间'}
                  </button>
                ) : (
                  <button
                    class="mobile-picker-trigger"
                    type="button"
                    data-picker={item.pickerKey}
                    name={item.name}
                    data-value={item.defaultValue || ''}
                    data-placeholder={item.placeholder || '请选择'}
                  >
                    {getPickerLabel(item, item.defaultValue) || item.placeholder || '请选择'}
                  </button>
                )}
                </div>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  ))}
        {canAdd && (
          <div class="filter-btn-wrapper">
            <button class="filter-btn filter-btn-primary" id="addBtn">＋ 添加</button>
            <button class="filter-btn filter-btn-danger" id="deleteBtn">－ 删除</button>
          </div>
        )}
  <AlertBar type="error" id="errorBar" autoClose={true} />
  <AlertBar type="success" id="successBar" autoClose={true} />
</div>

<script is:inline>
    async function onFileChange(e) {
      const target = e.target;
      const file = target.files?.[0];
      const fileDisplay = document.querySelector(`.file-display[data-name="${target.name}"]`);

      if (fileDisplay) {
        if (file) {
          fileDisplay.textContent = file.name;
          fileDisplay.classList.add('has-file');
          const formData = new FormData();
          formData.append('file', file);
          formData.append('name', file.name);
          const result = await fetch(`${window.__TASK_API_BASE__}/ajax/upload`, {
            method: 'POST',
            body: formData
          })
          if (result.ok){
            const data = await result.json();
            if (data.code === 200) {
              (successBar)?.show?.('文件上传成功');
            } else {
              (errorBar)?.show?.('文件上传失败');
            }
          } else {
            (errorBar)?.show?.('文件上传失败');
          }
        } else {
          const placeholder = fileDisplay.getAttribute('data-placeholder') || '选择文件';
          fileDisplay.textContent = placeholder;
          fileDisplay.classList.remove('has-file');
        }
      }
    }
</script>

<style is:global>
  .filter-container {
    width: 100%;
  }

  .filter-section {
    margin-bottom: 24px;
  }

  .filter-section-title {
    font-size: 16px;
    font-weight: 600;
    color: #1f2937;
    margin-bottom: 12px;
  }

  .filter-grid {
    display: grid;
    gap: 12px;
    grid-template-columns: 1fr;
  }

  .filter-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .filter-field-wrapper {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .filter-control {
    position: relative;
    width: 100%;
  }

  .filter-control > *:not(.filter-item-icon) {
    width: 100%;
  }

  .filter-field-label {
    font-size: 13px;
    font-weight: 600;
    color: #6b7280;
    letter-spacing: 0.02em;
  }

  .filter-item.half-width {
    grid-column: span 1;
  }

  .filter-item.full-width {
    grid-column: span 2;
  }

  .filter-item-icon {
    position: absolute;
    left: 14px;
    top: 50%;
    transform: translateY(-50%);
    font-size: 16px;
    color: #9ca3af;
    pointer-events: none;
    width: 20px;
    text-align: center;
  }

  .filter-input {
    width: 100%;
    padding: 12px 14px 12px 40px;
    border-radius: 12px;
    border: 1px solid #e5e7eb;
    background: #fff;
    font-size: 16px;
    color: #374151;
    transition: all 0.2s ease;
  }

  .filter-input:focus {
    outline: none;
    border-color: #667eea;
    box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
  }

  /* 两列布局 */
  .filter-grid.two-cols {
    grid-template-columns: 1fr 1fr;
  }

  /* 文件上传样式 */
  .file-upload-wrapper {
    flex: 1;
    display: flex;
  }

  .file-input {
    position: absolute;
    opacity: 0;
    width: 0.1px;
    height: 0.1px;
    overflow: hidden;
    z-index: -1;
  }

  .file-label {
    flex: 1;
    display: flex;
    align-items: center;
    padding: 12px 14px 12px 40px;
    border-radius: 12px;
    border: 1px solid #e5e7eb;
    background: #fff;
    font-size: 16px;
    color: #9ca3af;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .file-label:hover {
    border-color: #d1d5db;
  }

  .file-input:focus + .file-label {
    outline: none;
    border-color: #667eea;
    box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
  }

  .file-display {
    flex: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .file-display.has-file {
    color: #374151;
    font-weight: 500;
  }

  /* 按钮样式 */
  .filter-btn-wrapper {
    display: flex;
    gap: 12px;
    margin-top: 16px;
    justify-content: center;
  }

  .filter-btn {
    padding: 12px 24px;
    border-radius: 8px;
    border: none;
    font-size: 16px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
    min-width: 120px;
  }

  .filter-btn-primary {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
  }

  .filter-btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(102, 126, 234, 0.3);
  }

  .filter-btn-danger {
    background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
    color: white;
  }

  .filter-btn-danger:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(245, 87, 108, 0.3);
  }

  @media (max-width: 768px) {
    .filter-item.half-width {
      grid-column: span 1;
    }

    .filter-btn-wrapper {
      flex-direction: column;
    }

    .filter-btn {
      min-width: auto;
    }
  }
</style>

<script>
  // 文件上传处理
  document.addEventListener('DOMContentLoaded', () => {
    const fileInputs = document.querySelectorAll('.file-input');

    fileInputs.forEach((input) => {
      input.addEventListener('change', (e) => {
        const target = e.target as HTMLInputElement;
        const file = target.files?.[0];
        const fileDisplay = document.querySelector(`.file-display[data-name="${target.name}"]`);

        if (fileDisplay) {
          if (file) {
            fileDisplay.textContent = file.name;
            fileDisplay.classList.add('has-file');
          } else {
            const placeholder = fileDisplay.getAttribute('data-placeholder') || '选择文件';
            fileDisplay.textContent = placeholder;
            fileDisplay.classList.remove('has-file');
          }
        }
      });
    });

    // 添加和删除按钮事件处理
    const addBtn = document.getElementById('addBtn');
    const deleteBtn = document.getElementById('deleteBtn');

    if (addBtn) {
      addBtn.addEventListener('click', () => {
        // 触发自定义事件，让父组件监听
        window.dispatchEvent(new CustomEvent('filterAdd'));
      });
    }

    if (deleteBtn) {
      deleteBtn.addEventListener('click', () => {
        // 触发自定义事件，让父组件监听
        window.dispatchEvent(new CustomEvent('filterDelete'));
      });
    }
  });
</script>
