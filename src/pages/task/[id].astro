---
import { Debug } from 'astro:components';
import { isProject } from '../../utils/map';

export async function getStaticPaths() {
  return [{ params: { id: "" } }];
}

const { id } = Astro.params;

let task: any = null;
const proxyUrl = `${Astro.url.origin}/proxy`;
let taskName = ""

try {
	const taskRes = await fetch(proxyUrl, {
		headers: {
			"Content-Type": "application/json",
			"Cookie": Astro.request.headers.get("cookie") || "",
		},
		method: 'POST',
		body: JSON.stringify({
			path: `/taskorder/show`,
			id: id
		}),
	});
	if (taskRes.status === 401) {
		// 在SSR环境下无法直接跳转，返回空数据让前端处理
		task = {
			data: {},
			error: "未授权，请重新登录",
			code: 401,
		};
	} else {
		task = await taskRes.json();
		// 检查业务状态码401
		if (task.code === 401) {
			task = {
				data: {},
				error: "未授权，请重新登录",
				code: 401,
			};
		} else if (task.code === 1) {
			task = task.data || task;
			let hall_orderNumber = task.hall_orderNumber ? '（' + task.hall_orderNumber + '）' : ''
			taskName = task.statusInfo === '待接单' ? '接取后可见项目全称' : isProject(task.orderType) ? task.hall_customer + hall_orderNumber : task.name;
		}
	}
}catch(e){
	console.log(e)
}
