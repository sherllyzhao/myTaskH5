        background: linear-gradient(135deg, #f1f5f9 0%, #cbd5e1 100%);
        border-color: #cbd5e1;
        transform: translateY(-2px) scale(1.02);
        color: #475569;
      }

      /* 客户信息卡片特殊样式 */
      .client-info {
        background: linear-gradient(135deg, #f0f9ff 0%, #e0f2fe 100%);
        border: 2px solid #bae6fd;
      }

      .client-info::before {
        background: linear-gradient(90deg, #0ea5e9, #0284c7, #0369a1);
      }

      .client-info .section-title {
        color: #0c4a6e;
      }

      .client-info .info-item {
        background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
        border-color: #cbd5e1;
      }

      /* 佣金修改记录样式 */
      .history-list {
        space-y: 12px;
      }

      .history-item {
        padding: 16px 20px;
        background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
        border-radius: 12px;
        border-left: 4px solid #3b82f6;
        margin-bottom: 12px;
      }

      .history-date {
        color: #3b82f6;
        font-weight: 600;
        font-size: 12px;
        margin-bottom: 8px;
      }

      .history-changes {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        gap: 12px;
        font-size: 12px;
      }

      .history-change {
        text-align: center;
      }

      .history-label {
        color: #64748b;
        margin-bottom: 4px;
        font-weight: 500;
      }

      .history-value {
        color: #1e293b;
        font-weight: 600;
      }

      /* 变更记录样式 */
      .change-list {
        margin-top: 16px;
      }

      .change-item {
        padding: 16px 20px;
        background: linear-gradient(135deg, #fef7ff 0%, #f3e8ff 100%);
        border-radius: 12px;
        border-left: 4px solid #a855f7;
        margin-bottom: 12px;
      }

      .change-date {
        color: #a855f7;
        font-weight: 600;
        font-size: 12px;
        margin-bottom: 4px;
      }

      .change-note {
        color: #6b21a8;
        font-size: 13px;
