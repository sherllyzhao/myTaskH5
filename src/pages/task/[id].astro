      }

      /* 执行信息卡片样式 */
      .execution-list {
        display: flex;
        flex-direction: column;
        gap: 16px;
        margin-top: 16px;
      }

      .execution-item {
        background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
        border-radius: 12px;
        padding: 20px;
        border: 1px solid #e2e8f0;
        transition: all 0.3s ease;
        position: relative;
        overflow: hidden;
      }

      .execution-item:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
        border-color: #cbd5e1;
      }

      .execution-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 16px;
        padding-bottom: 12px;
        border-bottom: 2px solid #e2e8f0;
      }

      .execution-type {
        display: flex;
        align-items: center;
        gap: 8px;
        font-weight: 500;
        font-size: 15px;
        color: #1e293b;
        letter-spacing: 0.3px;
      }

      .execution-amount {
        background: linear-gradient(135deg, #fef7ff 0%, #f3e8ff 100%);
        color: #7c3aed;
        padding: 6px 12px;
        border-radius: 16px;
        font-weight: 600;
        font-size: 13px;
