        gap: 12px;
        margin-bottom: 16px;
      }

      .execution-detail {
        display: flex;
        flex-direction: column;
        gap: 4px;
      }

      .execution-detail-label {
        color: #64748b;
        font-size: 10px;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.6px;
      }

      .execution-detail-value {
