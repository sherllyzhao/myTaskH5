---
import { Debug } from "astro:components";
import {
  isProject,
  getTypeName,
  getTotalMoney,
  getBaseCommission,
  getAddCommission,
  isWaiting,
  earlyWarningOfConstructionPeriod,
  isOldVersion,
} from "../../utils/map";
import AttachmentViewer from "../../components/AttachmentViewer.astro";
import ProjectPerformance from "../../components/ProjectPerformance.astro";
import TaskPerformance from "../../components/TaskPerformance.astro";
import WithdrawalInfo from "../../components/WithdrawalInfo.astro";
import AcceptanceRecord from "../../components/AcceptanceRecord.astro";
import FilterDrawer from "../../components/FilterDrawer.astro";
import AddExecution from "../../components/AddExecution.astro";

export async function getStaticPaths() {
  return [{ params: { id: "" } }];
}

const { id } = Astro.params;
const oid = Astro.url.searchParams.get('oid')

let task: any = null;
const proxyUrl = `${Astro.url.origin}/proxy`;
let taskName = "";

try {
  const taskRes = await fetch(proxyUrl, {
    headers: {
      "Content-Type": "application/json",
      Cookie: Astro.request.headers.get("cookie") || "",
    },
    method: "POST",
    body: JSON.stringify({
      path: `/taskorder/show`,
      id: id,
      oid: oid
    }),
  });
  if (taskRes.status === 401) {
    // 在SSR环境下无法直接跳转，返回空数据让前端处理
    task = {
      data: {},
      error: "未授权，请重新登录",
      code: 401,
    };
  } else {
    task = await taskRes.json();
    // 检查业务状态码401
    if (task.code === 401) {
      task = {
        data: {},
        error: "未授权，请重新登录",
        code: 401,
      };
    } else if (task.code === 1) {
      task = task.data || task;
      let hall_orderNumber = task.hall_orderNumber
        ? "（" + task.hall_orderNumber + "）"
        : "";
      taskName =
        isWaiting(task)
          ? "接取后可见项目全称"
          : !isOldVersion(task.orderType)
            ? task.hall_customer + hall_orderNumber
            : task.name;
    }
  }
} catch (e) {
  console.log(e);
}

let custom: any = null;
let customId: string | number = "";
let showDemandFile: boolean = false;

try {
  const custormRes = await fetch(proxyUrl, {
    headers: {
      "Content-Type": "application/json",
      Cookie: Astro.request.headers.get("cookie") || "",
    },
    method: "POST",
    body: JSON.stringify({
      path: `/taskorder/getCustomerByNumbersy`,
      orderNumber: task.hall_orderNumber,
    }),
  });
  if (custormRes.status === 401) {
    // 在SSR环境下无法直接跳转，返回空数据让前端处理
    task = {
      data: {},
      error: "未授权，请重新登录",
      code: 401,
    };
  } else {
    custom = await custormRes.json();
    if (custom.code === 1) {
      custom = custom.data || custom;
	  customId = custom.item_id || "";
	  showDemandFile = !!custom;
    }
  }
} catch (e) {
  console.log(e);
}


// 示例数据结构，实际应该从 props 传入
const executionData: any[] = [];
let appendlogId: string | number = "";

if(task.appendlog){
  appendlogId = task.appendlog.id
  let annex = task.appendlog.annex ? task.appendlog.annex.split(',') : []
  let username = task.appendlog.username ? task.appendlog.username.split(',') : []
  let password = task.appendlog.password ? task.appendlog.password.split(',') : []
  annex.forEach((item: {
    annex: string;
    username: string;
    password: string;
    statustxt: string;
    status: string;
    filelist: string;
    audittime: string;
    createtime: string;
  }, index: number) => {
    executionData.push({
      annex: item,
      username: username[index],
      password: password[index],
      statustxt: task.appendlog?.statustxt,
      status: task.appendlog?.status,
      filelist: task.appendlog?.filelist,
      audittime: task.appendlog?.audittime,
      createtime: task.appendlog?.createtime,
      description: task.appendlog?.description
    })
  })
}
---

<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>任务详情</title>
    <link rel="stylesheet" href="/common.css" />
    <link rel="stylesheet" href="/task-detail-styles.css" />
    <script src="/js/auth.js" defer></script>
    <style>
        .task-badge{
            margin-left: 10px;
        }
    </style>
  </head>
  <body>
    <div class="container">
      <div class="detail-wrap">
	      <!--<Debug data={task} />-->

        <div class="detail-header">
          <div class="detail-title">
            <div>
              {
                task.orderType && (
                    <span
                      class={`type-badge ${isProject(task.orderType) ? "type-project" : "type-task"}`}
                    >
                      {isProject(task.orderType) ? "📁 项目" : "📋 任务"}
                    </span>
                )
              }
              {
                task.statusInfo && <div class={`task-badge status-${task.statusInfo || "待接单"}`}>
			              💼 {task.statusInfo || "待接单"}
		              </div>
              }
            </div>
            <div class="title-text">
              <span>{taskName}</span>
            </div>
            <div class="tag-wrap">
              {
                task.hallTypeTitle && (
                  <span class="tag tag-type-blue">{task.hallTypeTitle}</span>
                )
              }
              {
                task.button_info && (
                  <span
                    class={`tag tag-overdue tag-overdue-${earlyWarningOfConstructionPeriod(task.button_color)}`}
                  >
                    {task.button_info}
                  </span>
                )
              }
              {
                task.timeout && (
                  <span class="tag tag-pending-2d">{task.timeout}</span>
                )
              }
            </div>
          </div>
        </div>

        <div class="detail-content">
          <!-- 基本信息 -->
          <div class="detail-card">
            <div class="section-title">📋 基本信息</div>
            {
              task.positionlistarr && task.positionlistarr.length > 0 && (
                <div
                  class="info-item info-item-full blue"
                  style="margin-bottom: 12px;"
                >
                  <span class="info-label">👔 可接单岗位</span>
                  <span class="info-value info-value-jobs">
                    {task.positionlistarr
                      .map((item: any) => {
                        return item.position;
                      })
                      .join("、")}
                  </span>
                </div>
              )
            }
            <div class="info-grid">
              <div class="info-item">
                <span class="info-label">🏢 发布公司</span>
                <span class="info-value">{task.company || "-"}</span>
              </div>
              <div class="info-item">
                <span class="info-label">👤 发布人</span>
                <span class="info-value"
                  >{task.username || "公司主账号发布"}</span
                >
              </div>
              <div class="info-item">
                <span class="info-label">📅 发布时间</span>
                <span class="info-value">{task.ordertime || "-"}</span>
              </div>
              <div class="info-item">
                <span class="info-label">📅 接单时间</span>
                <span class="info-value">{task.performtime || "-"}</span>
              </div>
              <div class="info-item">
                <span class="info-label">📅 截止日期</span>
                <span class="info-value">{task.enddatatime || "-"}</span>
              </div>
              <div class="info-item">
                <span class="info-label"
                  >⏰ {getTypeName(task.orderType)}工期</span
                >
                <span class="info-value"
                  >{
                    task.hall_duration ? `${task.hall_duration}个工作日` : "-"
                  }</span
                >
              </div>
              <div class="info-item">
                <span class="info-label">📅 完成时间</span>
                <span class="info-value">{task.completiontime || "-"}</span>
              </div>
              <div class="info-item">
                <span class="info-label">🔢 项目编号</span>
                <span class="info-value"
                  >{
                    isWaiting(task)
                      ? getTypeName(task.orderType) + "接取后展示"
                      : (task.hall_orderNumber ?? "-")
                  }</span
                >
              </div>
              <div class="info-item">
                <span class="info-label">💰 总金额</span>
                <span class="info-value">¥{getTotalMoney(task) || "0.00"}</span>
              </div>
            </div>
            {
              task.description && (
                <div class="info-item info-item-full" style="margin-top: 12px;">
                  <span class="info-label">备注</span>
                  <span class="info-value info-value-jobs">
                    {task.description}
                  </span>
                </div>
              )
            }

            <!-- 附件展示 -->
            {
              task.functionfilelist && task.functionfilelist.length > 0 && (
                <div>
                  <div class="info-label">功能文档</div>
                  <div style="margin-top: 12px;">
                    <div class="info-label" style="margin-bottom: 8px;">
                      📎 附件
                    </div>
                    <AttachmentViewer attachments={task.functionfilelist} />
                  </div>
                </div>
              )
            }
          </div>

          <!-- 佣金信息 -->
          <div class="detail-card">
            <div class="section-title">💰 佣金信息</div>
            <div class="salary-section">
              <div class="salary-card">
                <div class="salary-label">总佣金</div>
                <div class="salary-value">
                  ¥ {getTotalMoney(task) || "0.00"}
                </div>
              </div>
              <div class="salary-card">
                <div class="salary-label">基础佣金</div>
                <div class="salary-value">
                  ¥ {getBaseCommission(task) || "0.00"}
                </div>
              </div>
              <div class="salary-card">
                <div class="salary-label">加价佣金</div>
                <div class="salary-value">
                  ¥ {getAddCommission(task) || "0.00"}
                </div>
              </div>
            </div>
            {
              task.desc && (
                <div class="info-item info-item-full" style="margin-top: 12px;">
                  <span class="info-label">报价说明</span>
                  <span class="info-value info-value-jobs">{task.desc}</span>
                </div>
              )
            }
          </div>

          <!-- 客户信息 -->
			{
				custom && !isWaiting(task) && (
					<div class="detail-card client-info">
						<div class="section-title">👤 客户信息</div>
						<div class="info-grid">
						<div class="info-item">
							<span class="info-label">👤 客户名称</span>
							<span class="info-value">{custom?.customer?.customer_name ?? '-'}</span>
						</div>
						<div class="info-item">
							<span class="info-label">🔢 项目编号</span>
							<span class="info-value">{custom.hall_orderNumber ?? '-'}</span>
						</div>
						<div class="info-item">
							<span class="info-label">📞 手机号</span>
							<span class="info-value">{custom?.contact?.contact_phone ?? '-'}</span>
						</div>
						<div class="info-item">
							<span class="info-label">👤 客户姓名</span>
							<span class="info-value">{custom?.contact?.contacts ?? '-'}</span>
						</div>
						<div class="info-item">
							<span class="info-label">📧 email</span>
							<span class="info-value">{custom?.contact?.email ?? '-'}</span>
						</div>
						<div class="info-item">
							<span class="info-label">📍 联系地址</span>
							<span class="info-value">{custom?.contact?.contact_address ?? '-'}</span>
						</div>
						</div>
					</div>
				)
			}

          <!-- 佣金修改记录 -->
		   {
				task.moneyeditlst && task.moneyeditlst.length > 0 && !isWaiting(task) && (
					<div class="detail-card">
						<div class="section-title">📊 佣金修改记录</div>
							<div class="history-list">
								{task.moneyeditlst.map((record: any) => (
									<div class="history-item">
										<div class="history-date">{record.createtime || '-'}</div>
										<div class="history-changes">
											<div class="history-change">
												<div class="history-label">修改依据：</div>
												<div class="history-value">{record.remarks || '-'}</div>
											</div>
											<div class="history-change">
												<div class="history-label">修改前：</div>
												<div class="history-value">¥{record.befor || '0.00'}</div>
											</div>
											<div class="history-change">
												<div class="history-label">修改后：</div>
												<div class="history-value">¥{record.after || '0.00'}</div>
											</div>
										</div>
									</div>
								))}
							</div>
					</div>
				)
		   }

          <!-- 变更记录 -->
		   {
				!isWaiting(task) && isProject(task.orderType) && (
					<div class="detail-card">
						<div class="section-title">📝 变更记录</div>
						<div class="change-list">
							<div class="change-item">
								<div class="change-date">2025-06-28 15:14:30 增加佣金</div>
								<div class="change-note">佣金变更金额限制</div>
							</div>
							<div class="change-item">
								<div class="change-date">2024-12-17 14:49:23 增加佣金</div>
								<div class="change-note">1</div>
							</div>
							<div class="change-item">
								<div class="change-date">2024-12-17 09:19:51 新增需求</div>
								<div class="change-note">dz20141217</div>
							</div>
							<div class="change-item">
								<div class="change-date">2024-12-17 09:38:33 新增需求</div>
								<div class="change-note">1</div>
							</div>
						</div>
					</div>
				)
		   }

          <!-- 执行信息 -->
          {
            !isWaiting(task) && (
               isProject(task.orderType) ? (<ProjectPerformance data={task} />) : (<TaskPerformance data={task} executionData={executionData} />)
            )
          }

          <!-- 验收记录 -->
          {
            !isWaiting(task) && isProject(task.orderType) && (
	          <AcceptanceRecord/>
            )
          }

          <!-- 提现信息 -->
          {
            !isWaiting(task) && !isProject(task.orderType) && (<WithdrawalInfo data={task} />)
          }
        </div>

        <div class="action-buttons">
          {
            isWaiting(task) && (
              <button class="action-btn action-btn-primary">🚀 立即接取</button>
            )
          }
          <a href="javascript:history.back()" class="action-btn action-btn-secondary">返回列表</a>
          <a href="javascript:history.back()" class="action-btn action-btn-primary">提交完成</a>
        </div>
      </div>

	    <FilterDrawer id="filterDrawer" title="编辑功能地址">
		    <Fragment slot="header">
			    <h3 class="filter-drawer-title">编辑功能地址</h3>
			    <button class="filter-drawer-close" onclick="closeFilterDrawer()"
			    >✕</button
			    >
		    </Fragment>

            <AddExecution taskId={task.id} executionData={executionData} appendlogId={appendlogId} />
	    </FilterDrawer>
    </div>
    <script is:inline src="/js/drawer.js"></script>
  </body>
</html>
