<html lang="zh-CN">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="generator" content={Astro.generator} />
		<title>我的佣金</title>
		<link rel="stylesheet" href="/common.css" />
		<style>
			/* 我的佣金页面特有样式 */
			.commission-stats {
				padding: 16px;
				background: white;
				border-bottom: 1px solid #eee;
			}
			
			.commission-grid {
				display: grid;
				grid-template-columns: repeat(5, 1fr);
				gap: 12px;
				text-align: center;
			}
			
			.commission-item {
				padding: 12px 8px;
			}
			
			.commission-label {
				font-size: 11px;
				color: #666;
				margin-bottom: 6px;
			}
			
			.commission-value {
				font-size: 14px;
				font-weight: bold;
				color: #333;
			}
			
			.commission-card {
				margin-bottom: 16px;
			}
			
			.commission-header {
				display: flex;
				justify-content: space-between;
				align-items: center;
				margin-bottom: 12px;
			}
			
			.apply-time {
				font-size: 12px;
				color: #666;
			}
			
			.commission-status {
				padding: 4px 8px;
				border-radius: 4px;
				font-size: 11px;
				font-weight: bold;
			}
			
			.commission-details {
				display: grid;
				grid-template-columns: 1fr 1fr 1fr;
				gap: 12px;
				margin-bottom: 12px;
			}
			
			.detail-item {
				text-align: center;
				padding: 8px;
				background: #f8f9fa;
				border-radius: 4px;
			}
			
			.detail-label {
				font-size: 10px;
				color: #666;
				margin-bottom: 4px;
			}
			
			.detail-value {
				font-size: 12px;
				font-weight: bold;
				color: #333;
			}
			
			.project-name {
				font-size: 13px;
				color: #333;
				margin-bottom: 8px;
				font-weight: 500;
			}
			
			.payment-time {
				font-size: 11px;
				color: #666;
				text-align: right;
			}
			
			.action-link {
				color: #409eff;
				text-decoration: none;
				font-size: 12px;
				text-align: center;
				display: block;
				padding: 8px;
				border: 1px solid #409eff;
				border-radius: 4px;
				margin-top: 8px;
			}
			
			@media (max-width: 768px) {
				.commission-grid {
					grid-template-columns: repeat(3, 1fr);
					gap: 8px;
				}
				
				.commission-details {
					grid-template-columns: 1fr;
					gap: 8px;
				}
			}
		</style>
	</head>
	<body>
		<div class="container">
			<div class="header">
				<div class="nav-tabs">
					<div class="nav-tab" onclick="window.location.href='/'">任务大厅</div>
