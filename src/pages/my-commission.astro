						<div class="detail-item">
							<div class="detail-label">佣金金额</div>
							<div class="detail-value amount">¥0.80</div>
						</div>
						<div class="detail-item">
							<div class="detail-label">打款时间</div>
							<div class="detail-value">08-13</div>
