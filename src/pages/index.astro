    <style is:global>
      /* 任务大厅特有样式 */
      .task-card {
        position: relative;
        overflow: hidden;
      }

      .task-badge {
        position: absolute;
        top: 20px;
        right: 20px;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 8px 16px;
        border-radius: 25px;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.5px;
        text-transform: uppercase;
      }

      .task-title {
        font-size: 18px;
        font-weight: 700;
        margin-bottom: 16px;
        padding-right: 80px;
        color: #1e293b;
        line-height: 1.4;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 70%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
      }

      .task-info {
        margin-bottom: 16px;
        background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
        border-radius: 12px;
        padding: 16px;
        border: 1px solid #e2e8f0;
      }

      .task-info-row {
        display: flex;
        justify-content: space-between;
        margin-bottom: 12px;
        font-size: 14px;
        align-items: center;
      }

      .task-info-row:last-child {
        margin-bottom: 0;
      }

      .task-info-label {
        color: #64748b;
        font-weight: 600;
        min-width: 80px;
      }

      .task-info-value {
        color: #1e293b;
        font-weight: 500;
        text-align: right;
        flex: 1;
      }

      .task-salary {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
        margin: 20px 0;
        padding: 20px;
        background: linear-gradient(135deg, #fef7ff 0%, #f3e8ff 100%);
        border-radius: 16px;
        border: 2px solid #e9d5ff;
        position: relative;
        overflow: hidden;
      }

      .task-salary::before {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 3px;
        background: linear-gradient(90deg, #c084fc, #a855f7, #9333ea);
      }

      .salary-item {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        position: relative;
      }

      .salary-item::after {
        content: "";
        position: absolute;
        top: -10px;
        left: 50%;
        transform: translateX(-50%);
        width: 4px;
        height: 4px;
        background: #a855f7;
        border-radius: 50%;
        opacity: 0.6;
      }

      .salary-label {
        color: #7c3aed;
        font-weight: 600;
        margin-bottom: 8px;
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
      }

      .salary-value {
        font-weight: 800;
        font-size: 20px;
        background: linear-gradient(
          135deg,
          #c084fc 0%,
          #a855f7 50%,
          #9333ea 100%
        );
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        text-shadow: 0 2px 4px rgba(168, 85, 247, 0.2);
      }

      .task-actions {
        display: flex;
        gap: 16px;
        margin-top: 24px;
        position: relative;
        z-index: 10;
      }

      .task-actions .btn {
        flex: 1;
        padding: 16px 20px;
        font-size: 15px;
        font-weight: 600;
        border-radius: 16px;
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        position: relative;
        overflow: hidden;
      }

      .task-actions .btn-primary {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        box-shadow:
          0 8px 24px rgba(102, 126, 234, 0.3),
          inset 0 1px 0 rgba(255, 255, 255, 0.2);
      }

      .task-actions .btn-primary:hover {
        transform: translateY(-4px) scale(1.05);
        box-shadow:
          0 16px 40px rgba(102, 126, 234, 0.4),
          inset 0 1px 0 rgba(255, 255, 255, 0.3);
      }

      .task-actions .btn-secondary {
        background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%);
        border: 2px solid #e2e8f0;
        color: #64748b;
        text-shadow: none;
        text-decoration: none;
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .task-actions .btn-secondary:hover {
        background: linear-gradient(135deg, #f1f5f9 0%, #cbd5e1 100%);
        border-color: #cbd5e1;
        transform: translateY(-2px) scale(1.02);
        color: #475569;
      }

      /* 任务卡片装饰元素 */
      .task-card::after {
        content: "";
        position: absolute;
        bottom: -50%;
        left: -50%;
        width: 200%;
        height: 200%;
        background: radial-gradient(
          circle,
          rgba(102, 126, 234, 0.05) 0%,
          transparent 70%
        );
        transform: rotate(45deg);
        opacity: 0;
        transition: all 0.4s ease;
        z-index: 0;
        pointer-events: none;
      }

      .task-card:hover::after {
        opacity: 1;
        bottom: -40%;
        left: -40%;
      }

      /* 悬浮特效 */
      .task-card:hover {
        transform: translateY(-8px) scale(1.02);
      }

      .task-card:hover .task-title {
        background: linear-gradient(
          135deg,
          #667eea 0%,
          #764ba2 50%,
          #f093fb 100%
        );
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
      }

      .task-card:hover .salary-value {
        animation: number-glow 2s ease-in-out infinite;
      }

      @keyframes number-glow {
        0%,
        100% {
          transform: scale(1);
        }
        50% {
          transform: scale(1.05);
        }
      }

      /* 工期信息特殊样式 */
      .task-info-row .task-info-value[class*="工作日"] {
        background: linear-gradient(135deg, #10b981 0%, #059669 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        font-weight: 700;
      }

      /* 备注区域样式 */
      .task-info-row:last-child {
        background: linear-gradient(135deg, #fef3c7 0%, #fde68a 100%);
        padding: 12px;
        border-radius: 8px;
        border-left: 4px solid #f59e0b;
        margin-top: 8px;
      }

      .task-info-row:last-child .task-info-label {
        color: #92400e;
      }

      .task-info-row:last-child .task-info-value {
        color: #78350f;
        font-style: italic;
      }

      /* Loading 动画 */
      @keyframes spin {
        0% {
          transform: rotate(0deg);
        }
        100% {
          transform: rotate(360deg);
        }
      }
      /* 移动端选择器样式 */
      .mobile-picker-overlay {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.4);
        backdrop-filter: blur(2px);
        z-index: 9999;
        display: none;
      }
      .mobile-picker-sheet {
        position: absolute;
        left: 0;
        right: 0;
        bottom: 0;
        background: #fff;
        border-top-left-radius: 16px;
        border-top-right-radius: 16px;
        box-shadow: 0 -10px 30px rgba(0, 0, 0, 0.15);
        max-height: 60vh;
        display: flex;
        flex-direction: column;
        animation: slideUp 200ms ease-out;
      }
      @keyframes slideUp {
        from {
          transform: translateY(30%);
          opacity: 0;
        }
        to {
          transform: translateY(0);
          opacity: 1;
        }
      }
      .mobile-picker-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 12px 16px;
        border-bottom: 1px solid #e5e7eb;
      }
      .mobile-picker-title {
        font-weight: 600;
        color: #111827;
      }
      .mobile-picker-list {
        overflow-y: auto;
        -webkit-overflow-scrolling: touch;
      }
      .mobile-picker-item {
        padding: 14px 16px;
        border-bottom: 1px solid #f3f4f6;
        display: flex;
        align-items: center;
        justify-content: space-between;
        font-size: 16px;
      }
      .mobile-picker-item.active {
        color: #4f46e5;
        background: #f5f7ff;
      }
      .mobile-picker-action {
        appearance: none;
        border: none;
        background: #f3f4f6;
        color: #111827;
        padding: 8px 12px;
        border-radius: 10px;
        font-weight: 600;
      }
      .mobile-picker-action.primary {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: #fff;
      }
      .mobile-picker-trigger {
        width: 100%;
        display: block;
        text-align: left;
        padding: 12px 14px 12px 40px;
        border-radius: 12px;
        border: 1px solid #e5e7eb;
        background: #fff;
        font-size: 16px;
        color: #374151;
      }
    </style>
    <style>
      .wrap{
        height: 100%;
        overflow: auto;
      }
    </style>
  </head>
  <body>
    <!-- 移动端选择器弹层 -->
    <MobilePicker />
    

    <script is:inline>
      // 全局函数定义，确保在HTML元素之前加载
      function openFilterDrawer() {
        const drawer = document.getElementById("filterDrawer");
        if (drawer) {
          drawer.classList.add("active");
          document.body.style.overflow = "hidden";
        }
      }

      function closeFilterDrawer(event) {
        if (event && event.target !== event.currentTarget) return;
        const drawer = document.getElementById("filterDrawer");
        if (drawer) {
          drawer.classList.remove("active");
          document.body.style.overflow = "";
        }
      }

      function resetFilters() {
        const selects = document.querySelectorAll(".mobile-picker-trigger");
        const inputs = document.querySelectorAll(".filter-input");

        selects.forEach((select) => {
          select.setAttribute("data-value", "");
          select.textContent = select.getAttribute("data-default") || "请选择";
          select.classList.remove("selected");
        });
        inputs.forEach((input) => (input.value = ""));
      }

      function getValue(type = 'picker', name){
        if(type === 'input'){
          return document.querySelector(`.filter-input[name='${name}']`).value
        }else{
          return document.querySelector(`.mobile-picker-trigger[data-picker='${name}']`).getAttribute("data-value")
        }
