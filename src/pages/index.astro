    <!-- 触底加载脚本 -->
    <script>
      import { createTaskCardHTML } from "../utils/taskCardTemplate";
      import { getCookie } from "../utils/tool";

      (function () {
        let currentPage = 1;
        let isLoading = false;
        let hasMore = true;
        const limit = 10;

        const clientToken =
          getCookie("token") || localStorage.getItem("token") || "";
        const clientEmployeeToken =
          getCookie("employee_token") ||
          localStorage.getItem("employee_token") ||
          "";

        // 获取 DOM 元素
        const taskListContainer = document.getElementById("taskListContainer");
        const loadingIndicator = document.getElementById("loadingIndicator");
        const noMoreData = document.getElementById("noMoreData");
        const totalCountEl = document.getElementById("totalCount");
        const loadedCountEl = document.getElementById("loadedCount");

        // 初始化总数
        const initialTotal = parseInt(totalCountEl?.textContent || "0");
        let loadedCount = parseInt(loadedCountEl?.textContent || "0");

        // 检查是否还有更多数据
        if (loadedCount >= initialTotal) {
          hasMore = false;
        }

        // 创建任务卡片 HTML - 使用共享模板函数
        function createTaskCard(task: any) {
          return createTaskCardHTML(task);
        }

        // 加载更多数据
        async function loadMore() {
          if (isLoading || !hasMore) {
            return;
          }

          isLoading = true;
          loadingIndicator && (loadingIndicator.style.display = "block");
          noMoreData && (noMoreData.style.display = "none");

          try {
            currentPage += 1;

            const response = await fetch(`/proxy`, {
              method: "POST",
              headers: {
                "Content-Type": "application/json",
              },
              body: JSON.stringify({
                path: "/taskorder/orderindex",
                page: currentPage,
                limit: limit,
                enterpriseSide: "pc",
              }),
            });

            if (response.status === 101) {
              window.location.href = "/login";
              return;
            }

            const result = await response.json();

            if (result.code === 101) {
              window.location.href = "/login";
              return;
            }

            if (result.code === 1) {
              const newTasks = result.data?.data || [];
              const total = result.data?.total || result.data?.count || 0;

              // 更新总数
              if (totalCountEl) {
                totalCountEl.textContent = total;
              }

              // 添加新任务到列表
              if (newTasks.length > 0) {
                newTasks.forEach((task: any) => {
                  const taskHTML = createTaskCard(task);
                  taskListContainer &&
                    taskListContainer.insertAdjacentHTML("beforeend", taskHTML);
                });

                loadedCount += newTasks.length;
                if (loadedCountEl) {
                  loadedCountEl.textContent = "" + loadedCount;
                }
              }

              // 检查是否还有更多数据
              if (loadedCount >= total || newTasks.length < limit) {
                hasMore = false;
                noMoreData && (noMoreData.style.display = "block");
              }
            } else {
              console.error("加载失败:", result.msg || "未知错误");
              hasMore = false;
            }
          } catch (error) {
            console.error("加载失败:", error);
            hasMore = false;
          } finally {
            isLoading = false;
            loadingIndicator && (loadingIndicator.style.display = "none");
          }
        }

        // 检测是否到达底部
        function checkScrollBottom() {
          // 获取滚动位置
          const scrollTop =
            window.pageYOffset || document.documentElement.scrollTop;
          const windowHeight = window.innerHeight;
          const documentHeight = document.documentElement.scrollHeight;

          // 距离底部还有 200px 时就开始加载
          if (scrollTop + windowHeight >= documentHeight - 200) {
            loadMore();
          }
        }

        // 防抖函数
        function debounce(func: (...args: any[]) => void, wait: number) {
          let timeout: any;
          return function executedFunction(...args: any[]) {
            const later = () => {
              clearTimeout(timeout);
              func(...args);
            };
            clearTimeout(timeout);
            timeout = setTimeout(later, wait);
          };
        }

        // 监听滚动事件（使用防抖）
        const debouncedScroll = debounce(checkScrollBottom, 200);
        window.addEventListener("scroll", debouncedScroll);

        // 初始检查一次（如果页面很短，直接显示没有更多数据）
        setTimeout(() => {
          if (!hasMore) {
            noMoreData && (noMoreData.style.display = "block");
          }
        }, 100);
      })();
    </script>
