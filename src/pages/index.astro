---
import FilterDrawer from "../components/FilterDrawer.astro";
import MobilePicker from "../components/MobilePicker.astro";
import FilterSection from "../components/FilterSection.astro";
import { Debug } from "astro:components";

// 初始化空数据，由客户端加载

/* 统计 */
let taskStatsRes: any;
let userInfo: any = null;
const proxyUrl = `${Astro.url.origin}/proxy`;
const proxyChina9Url = `${Astro.url.origin}/proxyChina9`;

try {
  // 获取用户信息
  const userInfoResponse = await fetch(proxyChina9Url, {
    method: "POST",
    headers: {
      "Content-Type": "application/json",
      Cookie: Astro.request.headers.get("cookie") || "",
    },
    body: JSON.stringify({
      path: "/user/infoClient", // 假设这是获取用户信息的接口路径，请根据实际情况修改
      enterpriseSide: "pc",
    }),
  });

  if (userInfoResponse.status === 200) {
    const userInfoResult = await userInfoResponse.json();
    if (userInfoResult.code === 200) {
      userInfo = userInfoResult.data;
      localStorage.setItem("userInfo", JSON.stringify(userInfo));
    }
  }
} catch (error: any) {
  console.error("❌ 获取用户信息失败:", error);
}

try {
  // 统计数据
  const statsResponse = await fetch(proxyUrl, {
    method: "POST",
    headers: {
      "Content-Type": "application/json",
      Cookie: Astro.request.headers.get("cookie") || "",
    },
    body: JSON.stringify({
      path: "/taskorder/monthinfo",
      enterpriseSide: "pc",
    }),
  });
  // 检查HTTP状态码401
  if (statsResponse.status === 401) {
    // 在SSR环境下无法直接跳转，返回空数据让前端处理
    taskStatsRes = {
      list: [],
      total: 0,
      error: "未授权，请重新登录",
      code: 401,
    };
  } else {
    const statsRes = await statsResponse.json();
    // 检查业务状态码401
    if (statsRes.code === 401) {
      taskStatsRes = {
        data: {},
        error: "未授权，请重新登录",
        code: 401,
      };
    } else if (statsRes.code === 1) {
      taskStatsRes = statsRes.data || statsRes;
    }
  }
} catch (error: any) {
  console.error("❌ SSR Error:", error);
}

const taskStats = taskStatsRes || {};

// 筛选组件配置
const filterGroups = [
  {
    title: "基础筛选",
    items: [
      {
        type: "input",
        icon: "📋",
        name: "name",
        placeholder: "项目名称或项目编号",
        width: "full"
      },
      {
        type: "picker",
        icon: "📁",
        name: "projectTask",
        placeholder: "项目类型",
        pickerKey: "projectTask",
        width: "full",
        defaultValue: '0',
        options: [
          {label: "全部项目和任务", value: "0"},
          {label: "仅项目", value: "1"},
          {label: "仅任务", value: "2"},
        ]
      },
      {
        type: "picker",
        icon: "🔽",
        name: "order",
        placeholder: "排序",
        pickerKey: "order",
        width: "full",
        defaultValue: "id",
        options: [
          {
            label: '发布时间由近到远排序',
            value: 'id',
          },
          {
            label: '佣金变更时间由近到远排序',
            value: 'commission_edittime',
          },
          {
            label: '工期到期天数由近到远排序',
            value: 'syday',
          }
        ]
      },
      {
        type: "number",
        icon: "💰",
        name: "amountStart",
        placeholder: "开始金额",
        width: "half",
      },
      {
        type: "number",
        icon: "💰",
        name: "amountEnd",
        placeholder: "结束金额",
        width: "half",
      }
    ]
  },
  {
    title: "时间筛选",
    items: [
      {
        type: "date-time-picker",
        icon: "📅",
        name: "publishStart",
        placeholder: "发布开始",
        pickerKey: "publishStart",
        width: "half"
      },
      {
        type: "date-time-picker",
        icon: "📅",
        name: "publishEnd",
        placeholder: "发布结束",
        pickerKey: "publishEnd",
        width: "half"
      },
      {
        type: "date-time-picker",
        icon: "📅",
        name: "deadlineStart",
        placeholder: "截止开始",
        pickerKey: "deadlineStart",
        width: "half"
      },
      {
        type: "date-time-picker",
        icon: "📅",
        name: "deadlineEnd",
        placeholder: "截止结束",
        pickerKey: "deadlineEnd",
        width: "half"
      },
      {
        type: "date-time-picker",
        icon: "📅",
        name: "orderStart",
        placeholder: "接单开始",
        pickerKey: "orderStart",
        width: "half"
      },
      {
        type: "date-time-picker",
        icon: "📅",
        name: "orderEnd",
        placeholder: "接单结束",
        pickerKey: "orderEnd",
        width: "half"
      }
    ]
  }
];
---

<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>任务管理</title>
    <link rel="stylesheet" href="/common.css" />
    <script src="/js/auth.js" defer></script>

    <style is:global>
      /* 任务大厅特有样式 */
      .task-card {
        position: relative;
        overflow: hidden;
      }

      .task-badge {
        position: absolute;
        top: 20px;
        right: 20px;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 8px 16px;
        border-radius: 25px;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.5px;
        text-transform: uppercase;
      }

      .task-title {
        font-size: 18px;
        font-weight: 700;
        margin-bottom: 16px;
        padding-right: 80px;
        color: #1e293b;
        line-height: 1.4;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 70%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
      }

      .task-info {
        margin-bottom: 16px;
        background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
        border-radius: 12px;
        padding: 16px;
        border: 1px solid #e2e8f0;
      }

      .task-info-row {
        display: flex;
        justify-content: space-between;
        margin-bottom: 12px;
        font-size: 14px;
        align-items: center;
      }

      .task-info-row:last-child {
        margin-bottom: 0;
      }

      .task-info-label {
        color: #64748b;
        font-weight: 600;
        min-width: 80px;
      }

      .task-info-value {
        color: #1e293b;
        font-weight: 500;
        text-align: right;
        flex: 1;
      }

      .task-salary {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
        margin: 20px 0;
        padding: 20px;
        background: linear-gradient(135deg, #fef7ff 0%, #f3e8ff 100%);
        border-radius: 16px;
        border: 2px solid #e9d5ff;
        position: relative;
        overflow: hidden;
      }

      .task-salary::before {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 3px;
        background: linear-gradient(90deg, #c084fc, #a855f7, #9333ea);
      }

      .salary-item {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        position: relative;
      }

      .salary-item::after {
        content: "";
        position: absolute;
        top: -10px;
        left: 50%;
        transform: translateX(-50%);
        width: 4px;
        height: 4px;
        background: #a855f7;
        border-radius: 50%;
        opacity: 0.6;
      }

      .salary-label {
        color: #7c3aed;
        font-weight: 600;
        margin-bottom: 8px;
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
      }

      .salary-value {
        font-weight: 800;
        font-size: 20px;
        background: linear-gradient(
          135deg,
          #c084fc 0%,
          #a855f7 50%,
          #9333ea 100%
        );
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        text-shadow: 0 2px 4px rgba(168, 85, 247, 0.2);
      }

      .task-actions {
        display: flex;
        gap: 16px;
        margin-top: 24px;
        position: relative;
        z-index: 10;
      }

      .task-actions .btn {
        flex: 1;
        padding: 16px 20px;
        font-size: 15px;
        font-weight: 600;
        border-radius: 16px;
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        position: relative;
        overflow: hidden;
      }

      .task-actions .btn-primary {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        box-shadow:
          0 8px 24px rgba(102, 126, 234, 0.3),
          inset 0 1px 0 rgba(255, 255, 255, 0.2);
      }

      .task-actions .btn-primary:hover {
        transform: translateY(-4px) scale(1.05);
        box-shadow:
          0 16px 40px rgba(102, 126, 234, 0.4),
          inset 0 1px 0 rgba(255, 255, 255, 0.3);
      }

      .task-actions .btn-secondary {
        background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%);
        border: 2px solid #e2e8f0;
        color: #64748b;
        text-shadow: none;
        text-decoration: none;
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .task-actions .btn-secondary:hover {
        background: linear-gradient(135deg, #f1f5f9 0%, #cbd5e1 100%);
        border-color: #cbd5e1;
        transform: translateY(-2px) scale(1.02);
        color: #475569;
      }

      /* 任务卡片装饰元素 */
      .task-card::after {
        content: "";
        position: absolute;
        bottom: -50%;
        left: -50%;
        width: 200%;
        height: 200%;
        background: radial-gradient(
          circle,
          rgba(102, 126, 234, 0.05) 0%,
          transparent 70%
        );
        transform: rotate(45deg);
        opacity: 0;
        transition: all 0.4s ease;
        z-index: 0;
        pointer-events: none;
      }

      .task-card:hover::after {
        opacity: 1;
        bottom: -40%;
        left: -40%;
      }

      /* 悬浮特效 */
      .task-card:hover {
        transform: translateY(-8px) scale(1.02);
      }

      .task-card:hover .task-title {
        background: linear-gradient(
          135deg,
          #667eea 0%,
          #764ba2 50%,
          #f093fb 100%
        );
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
      }

      .task-card:hover .salary-value {
        animation: number-glow 2s ease-in-out infinite;
      }

      @keyframes number-glow {
        0%,
        100% {
          transform: scale(1);
        }
        50% {
          transform: scale(1.05);
        }
      }

      /* 工期信息特殊样式 */
      .task-info-row .task-info-value[class*="工作日"] {
        background: linear-gradient(135deg, #10b981 0%, #059669 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        font-weight: 700;
      }

      /* 备注区域样式 */
      .task-info-row:last-child {
        background: linear-gradient(135deg, #fef3c7 0%, #fde68a 100%);
        padding: 12px;
        border-radius: 8px;
        border-left: 4px solid #f59e0b;
        margin-top: 8px;
      }

      .task-info-row:last-child .task-info-label {
        color: #92400e;
      }

      .task-info-row:last-child .task-info-value {
        color: #78350f;
        font-style: italic;
      }

      /* Loading 动画 */
      @keyframes spin {
        0% {
          transform: rotate(0deg);
        }
        100% {
          transform: rotate(360deg);
        }
      }
      /* 移动端选择器样式 */
      .mobile-picker-overlay {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.4);
        backdrop-filter: blur(2px);
        z-index: 9999;
        display: none;
      }
      .mobile-picker-sheet {
        position: absolute;
        left: 0;
        right: 0;
        bottom: 0;
        background: #fff;
        border-top-left-radius: 16px;
        border-top-right-radius: 16px;
        box-shadow: 0 -10px 30px rgba(0, 0, 0, 0.15);
        max-height: 60vh;
        display: flex;
        flex-direction: column;
        animation: slideUp 200ms ease-out;
      }
      @keyframes slideUp {
        from {
          transform: translateY(30%);
          opacity: 0;
        }
        to {
          transform: translateY(0);
          opacity: 1;
        }
      }
      .mobile-picker-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 12px 16px;
        border-bottom: 1px solid #e5e7eb;
      }
      .mobile-picker-title {
        font-weight: 600;
        color: #111827;
      }
      .mobile-picker-list {
        overflow-y: auto;
        -webkit-overflow-scrolling: touch;
      }
      .mobile-picker-item {
        padding: 14px 16px;
        border-bottom: 1px solid #f3f4f6;
        display: flex;
        align-items: center;
        justify-content: space-between;
        font-size: 16px;
      }
      .mobile-picker-item.active {
        color: #4f46e5;
        background: #f5f7ff;
      }
      .mobile-picker-action {
        appearance: none;
        border: none;
        background: #f3f4f6;
        color: #111827;
        padding: 8px 12px;
        border-radius: 10px;
        font-weight: 600;
      }
      .mobile-picker-action.primary {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: #fff;
      }
      .mobile-picker-trigger {
        width: 100%;
        display: block;
        text-align: left;
        padding: 12px 14px 12px 40px;
        border-radius: 12px;
        border: 1px solid #e5e7eb;
        background: #fff;
        font-size: 16px;
        color: #374151;
      }
    </style>
    <style>
      .wrap{
        height: 100%;
        overflow: auto;
      }
    </style>
  </head>
  <body>
    <!-- 移动端选择器弹层 -->
    <MobilePicker />

    <script is:inline src="/js/drawer.js"></script>
    <div class="container">
      <div class="wrap">
        <Debug data={userInfo} />
        
        <div class="header">
          <div class="nav-tabs">
            <div class="nav-tab active">任务大厅</div>
            <div class="nav-tab" onclick="window.location.href='/my-tasks'">
              我的任务
            </div>
            <div class="nav-tab" onclick="window.location.href='/my-commission'">
              我的佣金
            </div>
          </div>

          <div class="profile-section">
            <img src="/favicon.svg" alt="用户头像" class="avatar" />
            <a href="/profile" class="profile-btn">个人主页</a>
          </div>
        </div>

        <div class="stats-grid">
          <div class="stat-card">
            <div class="stat-title">本月抢单数</div>
            <div class="stat-detail">
              <div>
                项目：<span class="stat-value"
                  >{taskStats?.qd_num?.xmnum || 0}</span
                >
              </div>
              <div>
                任务：<span class="stat-value"
                  >{taskStats?.qd_num?.rwnum || 0}</span
                >
              </div>
            </div>
          </div>
          <div class="stat-card">
            <div class="stat-title">本月佣金金额</div>
            <div class="stat-detail">
              <div>
                项目：<span class="stat-value"
                  ><i>￥</i>{taskStats?.qd_price?.xmprice || 0}</span
                >
              </div>
              <div>
                任务：<span class="stat-value"
                  ><i>￥</i>{taskStats?.qd_price?.rwprice || 0}</span
                >
              </div>
            </div>
          </div>
          <div class="stat-card">
            <div class="stat-title">本月完结单数</div>
            <div class="stat-detail">
              <div>
                项目：<span class="stat-value"
                  >{taskStats?.end_num?.xmnum || 0}</span
                >
              </div>
              <div>
                任务：<span class="stat-value"
                  >{taskStats?.end_num?.rwnum || 0}</span
                >
              </div>
            </div>
          </div>
          <div class="stat-card">
            <div class="stat-title">本月完结金额</div>
            <div class="stat-detail">
              <div>
                项目：<span class="stat-value"
                  ><i>￥</i>{taskStats?.end_price?.xmprice || 0}</span
                >
              </div>
              <div>
                任务：<span class="stat-value"
                  ><i>￥</i>{taskStats?.end_price?.rwprice || 0}</span
                >
              </div>
            </div>
          </div>
        </div>

        <!-- 筛选器触发按钮 -->
        <button class="filter-trigger" onclick="openFilterDrawer()">
          🔍 筛选条件
        </button>

        <!-- 类型图例说明 -->
        <div class="type-legend">
          <div class="legend-title">📌 类型说明</div>
          <div class="legend-items">
            <div class="legend-item legend-project">
              <div class="legend-color"></div>
              <span class="legend-text">项目</span>
            </div>
            <div class="legend-item legend-task">
              <div class="legend-color"></div>
              <span class="legend-text">任务</span>
            </div>
          </div>
        </div>

        <div class="content">
          <!-- 加载中提示 - 直接在这里定义 -->
          <div id="manualLoadingIndicator" style="display: none; text-align: center; padding: 20px; background: linear-gradient(135deg, #eff6ff 0%, #dbeafe 100%); border-radius: 12px; margin: 16px 0; border: 2px solid #93c5fd; color: #1e40af; font-weight: 600; font-size: 15px;">
            <div style="display: inline-block; animation: spin 1s linear infinite; font-size: 24px; margin-right: 12px;">⏳</div>
            <span>加载中...</span>
          </div>

          <!-- 任务列表容器 - 状态元素将自动创建 -->
          <div id="taskListContainer">
            <!-- 任务列表将由客户端动态加载 -->
          </div>
        </div>
      </div>

      <!-- 筛选器抽屉组件 -->
      <FilterDrawer id="filterDrawer" title="筛选条件">
        <Fragment slot="header">
          <h3 class="filter-drawer-title">筛选条件</h3>
          <button class="filter-drawer-close" onclick="closeFilterDrawer()"
            >✕</button
          >
        </Fragment>

        <!-- 筛选组件 -->
        <FilterSection groups={filterGroups} />

        <Fragment slot="footer">
          <div class="filter-actions">
            <button
              class="filter-btn filter-btn-secondary"
              onclick="resetFilters()">🔄 重置</button
            >
            <button
              class="filter-btn filter-btn-primary"
              onclick="applyFilters(window.loadInitialData)">🔍 应用筛选</button
            >
          </div>
        </Fragment>
      </FilterDrawer>
    </div>

    <script :inline src="/js/cookies.js"></script>

    <!-- 用户信息全局变量 -->
    <script is:inline define:vars={{ userInfo }}>
      // 将用户信息设置为全局变量
      window.currentUserInfo = userInfo;
      console.log('当前用户信息:', window.currentUserInfo);

      // 处理接任务的全局函数
      window.handleTaskAccept = async function(event, taskId, taskCompanyId, taskCompanyName) {
        event.preventDefault();

        const currentUser = window.currentUserInfo;

        // 如果没有用户信息，提示登录
        if (!currentUser) {
          alert('请先登录');
          window.location.href = '/login';
          return;
        }

        // 获取用户的公司ID（根据实际的数据结构调整）
        const userCompanyName = currentUser?.companyInfo?.company_name || currentUser.companyName || '';

        // 检查是否为非本公司任务
        if (taskCompanyId && userCompanyName && taskCompanyId !== userCompanyName) {
          const taskCompanyText = taskCompanyName ? `"${taskCompanyName}"` : '其他公司';
          const userCompanyText = userCompanyName ? `您当前所属公司为"${userCompanyName}"` : '';

          const confirmMessage = `⚠️ 注意：这是${taskCompanyText}发布的任务！\n${userCompanyText}\n\n是否确认接取此任务？`;

          if (!confirm(confirmMessage)) {
            return; // 用户取消接取
          }
        }

        // 执行接任务的逻辑
        try {
          // 这里添加你的接任务API调用
          // 示例：
          // const response = await fetch('/api/accept-task', {
          //   method: 'POST',
          //   headers: { 'Content-Type': 'application/json' },
          //   body: JSON.stringify({ taskId })
          // });

          console.log('接取任务:', taskId);
          alert('任务接取成功！');

          // 刷新列表或跳转到任务详情页
          // window.location.reload();
          // 或者
          // window.location.href = `/task/${taskId}/`;

        } catch (error) {
          console.error('接取任务失败:', error);
          alert('接取任务失败，请重试');
        }
      };
    </script>

    <!-- 触底加载脚本 -->
    <script>
      import { createTaskCardHTML } from "../utils/taskCardTemplate";
      import { getCookie } from "../utils/tool";
      import { createListStateManager } from "../utils/listStateManager";

      // 全局变量定义
      let currentPage = 0; // 从0开始,第一次加载就是第1页
      let isLoading = false;
      let hasMore = true;
      const limit = 10;

      // 请求配置 - 与服务器端保持一致
      const requestConfig = {
        path: "/taskorder/orderindex",
        enterpriseSide: "pc"
      };

      // 获取 DOM 元素
      const taskListContainer = document.getElementById("taskListContainer");

      // ===== 初始化状态管理器 =====
      const stateManager = createListStateManager();

      // 创建任务卡片 HTML - 使用共享模板函数
      function createTaskCard(task: any) {
        return createTaskCardHTML(task);
      }

      // 全局加载数据函数
      window.loadInitialData = async function(formData: any = {}) {
          if (isLoading) return;

          isLoading = true;
          hasMore = true;

          // 显示手动加载指示器
          const manualLoadingIndicator = document.getElementById('manualLoadingIndicator');
          if (manualLoadingIndicator) {
            manualLoadingIndicator.style.display = 'block';
          }

          // 同时也尝试显示状态管理器的加载状态
          if (stateManager) {
            stateManager.onRequestStart();
          }

          try {
            currentPage = 1;

            // 发送请求
            const response = await fetch(`/proxy`, {
              method: "POST",
              headers: {
                "Content-Type": "application/json",
              },
              body: JSON.stringify({
                ...requestConfig,
                page: currentPage,
                limit: limit,
                ...formData
              }),
            });

            if (response.status === 401) {
              window.location.href = "/login";
              return;
            }

            const result = await response.json();

            if (result.code === 401) {
              window.location.href = "/login";
              return;
            }

            if (result.code === 1) {
              const tasks = result.data?.data || [];
              const total = result.data?.total || result.data?.count || 0;

              // 清空容器并添加新任务
              if (taskListContainer) {
                taskListContainer.innerHTML = "";

                if (tasks.length > 0) {
                  tasks.forEach((task: any) => {
                    const taskHTML = createTaskCard(task);
                    taskListContainer.insertAdjacentHTML("beforeend", taskHTML);
                  });
                } else {
                  // 没有数据时显示提示
                  taskListContainer.innerHTML = '<div style="text-align: center; padding: 40px; color: #666;">📭 暂无任务</div>';
                }
              }

              // 使用状态管理器更新状态
              const isComplete = stateManager.onRequestSuccess(total, tasks.length, limit);
              hasMore = !isComplete;

            } else {
              console.error("加载失败:", result.msg || "未知错误");
              if (taskListContainer) {
                taskListContainer.innerHTML = '<div style="text-align: center; padding: 40px; color: #f56565;">❌ 加载失败</div>';
              }
              stateManager.onRequestError();
            }
          } catch (error) {
            console.error("加载失败:", error);
            if (taskListContainer) {
              taskListContainer.innerHTML = '<div style="text-align: center; padding: 40px; color: #f56565;">❌ 网络错误</div>';
            }
            stateManager.onRequestError();
          } finally {
            isLoading = false;
            // 隐藏手动加载指示器
            const manualLoadingIndicator = document.getElementById('manualLoadingIndicator');
            if (manualLoadingIndicator) {
              manualLoadingIndicator.style.display = 'none';
            }
          }
        }

        const clientToken =
          getCookie("token") || localStorage.getItem("token") || "";
        const clientEmployeeToken =
          getCookie("employee_token") ||
          localStorage.getItem("employee_token") ||
          "";

        // 加载更多数据
        window.loadMore = async function() {
          if (isLoading || !hasMore) {
            return;
          }

          isLoading = true;
          stateManager.onRequestStart(); // 自动显示加载中状态

          try {
            currentPage += 1;

            const response = await fetch(`/proxy`, {
              method: "POST",
              headers: {
                "Content-Type": "application/json",
              },
              body: JSON.stringify({
                ...requestConfig,
                page: currentPage,
                limit: limit
              }),
            });

            if (response.status === 401) {
              window.location.href = "/login";
              return;
            }

            const result = await response.json();

            if (result.code === 401 || result.code === 401) {
              window.location.href = "/login";
              return;
            }

            if (result.code === 1) {
              const newTasks = result.data?.data || [];
              const total = result.data?.total || result.data?.count || 0;

              // 添加新任务到列表
              if (newTasks.length > 0) {
                newTasks.forEach((task: any) => {
                  const taskHTML = createTaskCard(task);
                  taskListContainer &&
                    taskListContainer.insertAdjacentHTML("beforeend", taskHTML);
                });
              }

              // 计算当前已加载总数
              const currentLoaded = (taskListContainer?.children.length || 0);

              // 使用状态管理器更新状态
              const isComplete = stateManager.onRequestSuccess(total, currentLoaded, limit);
              hasMore = !isComplete;

            } else {
              console.error("加载失败:", result.msg || "未知错误");
              stateManager.onRequestError();
              hasMore = false;
            }
          } catch (error) {
            console.error("加载失败:", error);
            stateManager.onRequestError();
            hasMore = false;
          } finally {
            isLoading = false;
          }
        }

        // 检测是否到达底部
        function checkScrollBottom() {
          // 获取 .wrap 滚动容器
          const wrapElement = document.querySelector('.wrap');
          if (!wrapElement) return;

          // 获取滚动位置
          const scrollTop = wrapElement.scrollTop;
          const scrollHeight = wrapElement.scrollHeight;
          const clientHeight = wrapElement.clientHeight;

          // 距离底部还有 200px 时就开始加载
          if (scrollTop + clientHeight >= scrollHeight - 200) {
            window.loadMore();
          }
        }

        // 防抖函数
        function debounce(func: (...args: any[]) => void, wait: number) {
          let timeout: any;
          return function executedFunction(...args: any[]) {
            const later = () => {
              clearTimeout(timeout);
              func(...args);
            };
            clearTimeout(timeout);
            timeout = setTimeout(later, wait);
          };
        }

        // 监听 .wrap 元素的滚动事件（使用防抖）
        const debouncedScroll = debounce(checkScrollBottom, 200);
        const wrapElement = document.querySelector('.wrap');
        if (wrapElement) {
          wrapElement.addEventListener("scroll", debouncedScroll);
        }

        // 页面加载时立即获取初始数据
        window.loadInitialData();
    </script>
  </body>
</html>
