---
import { Debug } from "astro:components";
import TaskCard from "../components/TaskCard.astro";
import LoginExpiredMessage from "../components/LoginExpiredMessage.astro";

/* 获取任务大厅列表 */
const employeeToken = Astro.cookies.get("employee_token")?.value;

// 使用和浏览器端一样的最小化请求数据
const postData = {
  path: '/taskorder/orderindex',  // 指定要调用的后端路径
  page: 1,
  limit: 10,
  enterpriseSide: "pc",
};

// SSR 模式：通过 Astro API 代理路由
const proxyUrl = `${Astro.url.origin}/proxy`;

let taskListResData: any = {
  list: [],
  total: 0,
};

try {
  // 直接使用 fetch 调用代理路由，不经过 http 工具
  const response = await fetch(proxyUrl, {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
      'Cookie': Astro.request.headers.get('cookie') || '',
    },
    body: JSON.stringify(postData),
  });

  // 检查HTTP状态码101
  if (response.status === 401) {
    // 在SSR环境下无法直接跳转，返回空数据让前端处理
    taskListResData = {
      list: [],
      total: 0,
      error: '未授权，请重新登录',
      code: 401
    };
  } else {
    const taskListRes = await response.json();

    // 检查业务状态码101
    if (taskListRes.code === 401) {
      taskListResData = {
        list: [],
        total: 0,
        error: '未授权，请重新登录',
        code: 101
      };
    } else if(taskListRes.code === 1){
      taskListResData = taskListRes.data || taskListRes;
    }
  }
} catch (error: any) {
  console.error("❌ SSR Error:", error);
  taskListResData = {
    list: [],
    total: 0,
    error: error.message || "请求失败",
  };
}

const taskList = taskListResData?.data || [];
const total = taskListResData?.total || taskListResData?.count || 0;

/* 统计 */
let taskStatsRes: any;
try {
  // 统计数据
  const statsResponse = await fetch(proxyUrl, {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
      'Cookie': Astro.request.headers.get('cookie') || '',
    },
    body: JSON.stringify({
      path: '/taskorder/monthinfo',
      enterpriseSide: "pc",
    }),
  });
  // 检查HTTP状态码101
  if (statsResponse.status === 401) {
    // 在SSR环境下无法直接跳转，返回空数据让前端处理
    taskListResData = {
      list: [],
      total: 0,
      error: '未授权，请重新登录',
      code: 401
    };
  } else {
    const statsRes = await statsResponse.json();
    // 检查业务状态码101
    if (statsRes.code === 401) {
      taskStatsRes = {
        data: {},
        error: '未授权，请重新登录',
        code: 101
      };
    } else if(statsRes.code === 1){
      taskStatsRes = statsRes.data || statsRes;
    }
  }
} catch (error: any) {
  console.error("❌ SSR Error:", error);
}

const taskStats = taskStatsRes || {};
---

<html lang="zh-CN">

  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>任务管理</title>
    <link rel="stylesheet" href="/common.css" />
    <script src="/js/auth.js" defer></script>
    <style is:global>
      /* 任务大厅特有样式 */
      .task-card {
        position: relative;
        overflow: hidden;
      }

      .task-badge {
        position: absolute;
        top: 20px;
        right: 20px;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 8px 16px;
        border-radius: 25px;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.5px;
        text-transform: uppercase;
      }

      .task-title {
        font-size: 18px;
        font-weight: 700;
        margin-bottom: 16px;
        padding-right: 80px;
        color: #1e293b;
        line-height: 1.4;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 70%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
      }

      .task-info {
        margin-bottom: 16px;
        background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
        border-radius: 12px;
        padding: 16px;
        border: 1px solid #e2e8f0;
      }

      .task-info-row {
        display: flex;
        justify-content: space-between;
        margin-bottom: 12px;
        font-size: 14px;
        align-items: center;
      }

      .task-info-row:last-child {
        margin-bottom: 0;
      }

      .task-info-label {
        color: #64748b;
        font-weight: 600;
        min-width: 80px;
      }

      .task-info-value {
        color: #1e293b;
        font-weight: 500;
        text-align: right;
        flex: 1;
      }

      .task-salary {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
        margin: 20px 0;
        padding: 20px;
        background: linear-gradient(135deg, #fef7ff 0%, #f3e8ff 100%);
        border-radius: 16px;
        border: 2px solid #e9d5ff;
        position: relative;
        overflow: hidden;
      }

      .task-salary::before {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 3px;
        background: linear-gradient(90deg, #c084fc, #a855f7, #9333ea);
      }

      .salary-item {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        position: relative;
      }

      .salary-item::after {
        content: "";
        position: absolute;
        top: -10px;
        left: 50%;
        transform: translateX(-50%);
        width: 4px;
        height: 4px;
        background: #a855f7;
        border-radius: 50%;
        opacity: 0.6;
      }

      .salary-label {
        color: #7c3aed;
        font-weight: 600;
        margin-bottom: 8px;
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
      }

      .salary-value {
        font-weight: 800;
        font-size: 20px;
        background: linear-gradient(
          135deg,
          #c084fc 0%,
          #a855f7 50%,
          #9333ea 100%
        );
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        text-shadow: 0 2px 4px rgba(168, 85, 247, 0.2);
      }

      .task-actions {
        display: flex;
        gap: 16px;
        margin-top: 24px;
        position: relative;
        z-index: 10;
      }

      .task-actions .btn {
        flex: 1;
        padding: 16px 20px;
        font-size: 15px;
        font-weight: 600;
        border-radius: 16px;
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        position: relative;
        overflow: hidden;
      }

      .task-actions .btn-primary {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        box-shadow:
          0 8px 24px rgba(102, 126, 234, 0.3),
          inset 0 1px 0 rgba(255, 255, 255, 0.2);
      }

      .task-actions .btn-primary:hover {
        transform: translateY(-4px) scale(1.05);
        box-shadow:
          0 16px 40px rgba(102, 126, 234, 0.4),
          inset 0 1px 0 rgba(255, 255, 255, 0.3);
      }

      .task-actions .btn-secondary {
        background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%);
        border: 2px solid #e2e8f0;
        color: #64748b;
        text-shadow: none;
        text-decoration: none;
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .task-actions .btn-secondary:hover {
        background: linear-gradient(135deg, #f1f5f9 0%, #cbd5e1 100%);
        border-color: #cbd5e1;
        transform: translateY(-2px) scale(1.02);
        color: #475569;
      }

      /* 任务卡片装饰元素 */
      .task-card::after {
        content: "";
        position: absolute;
        bottom: -50%;
        left: -50%;
        width: 200%;
        height: 200%;
        background: radial-gradient(
          circle,
          rgba(102, 126, 234, 0.05) 0%,
          transparent 70%
        );
        transform: rotate(45deg);
        opacity: 0;
        transition: all 0.4s ease;
        z-index: 0;
        pointer-events: none;
      }

      .task-card:hover::after {
        opacity: 1;
        bottom: -40%;
        left: -40%;
      }

      /* 悬浮特效 */
      .task-card:hover {
        transform: translateY(-8px) scale(1.02);
      }

      .task-card:hover .task-title {
        background: linear-gradient(
          135deg,
          #667eea 0%,
          #764ba2 50%,
          #f093fb 100%
        );
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
      }

      .task-card:hover .salary-value {
        animation: number-glow 2s ease-in-out infinite;
      }

      @keyframes number-glow {
        0%,
        100% {
          transform: scale(1);
        }
        50% {
          transform: scale(1.05);
        }
      }

      /* 工期信息特殊样式 */
      .task-info-row .task-info-value[class*="工作日"] {
        background: linear-gradient(135deg, #10b981 0%, #059669 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        font-weight: 700;
      }

      /* 备注区域样式 */
      .task-info-row:last-child {
        background: linear-gradient(135deg, #fef3c7 0%, #fde68a 100%);
        padding: 12px;
        border-radius: 8px;
        border-left: 4px solid #f59e0b;
        margin-top: 8px;
      }

      .task-info-row:last-child .task-info-label {
        color: #92400e;
      }

      .task-info-row:last-child .task-info-value {
        color: #78350f;
        font-style: italic;
      }

      /* Loading 动画 */
      @keyframes spin {
        0% {
          transform: rotate(0deg);
        }
        100% {
          transform: rotate(360deg);
        }
      }
    </style>
  </head>
  <body>
    <script is:inline>
      // 全局函数定义，确保在HTML元素之前加载
      function openFilterDrawer() {
        const drawer = document.getElementById("filterDrawer");
        if (drawer) {
          drawer.classList.add("active");
          document.body.style.overflow = "hidden";
        }
      }

      function closeFilterDrawer(event) {
        if (event && event.target !== event.currentTarget) return;
        const drawer = document.getElementById("filterDrawer");
        if (drawer) {
          drawer.classList.remove("active");
          document.body.style.overflow = "";
        }
      }

      function resetFilters() {
        const selects = document.querySelectorAll(".filter-select");
        const inputs = document.querySelectorAll(".filter-input");

        selects.forEach((select) => (select.selectedIndex = 0));
        inputs.forEach((input) => (input.value = ""));
      }

      function applyFilters() {
        closeFilterDrawer();
      }

      // ESC键关闭抽屉
      document.addEventListener("keydown", function (event) {
        if (event.key === "Escape") {
          closeFilterDrawer();
        }
      });
    </script>
    <div class="container">
      <div class="header">
        <div class="nav-tabs">
          <div class="nav-tab active">任务大厅</div>
          <div class="nav-tab" onclick="window.location.href='/my-tasks'">
            我的任务
          </div>
          <div class="nav-tab" onclick="window.location.href='/my-commission'">
            我的佣金
          </div>
        </div>

        <div class="profile-section">
          <img src="/favicon.svg" alt="用户头像" class="avatar" />
          <a href="/profile" class="profile-btn">👤 个人主页</a>
        </div>
      </div>

      <!-- <Debug data={taskStats} /> -->
      <div class="stats-grid">
        <div class="stat-card">
          <div class="stat-title">本月抢单数</div>
          <div class="stat-detail">
            <div>
              项目：<span class="stat-value">{taskStatsRes?.qd_num?.xmnum || 0}</span> 
            </div>
            <div>
              任务：<span class="stat-value">{taskStatsRes?.qd_num?.rwnum || 0}</span> 
            </div>
          </div>
        </div>
        <div class="stat-card">
          <div class="stat-title">本月佣金金额</div>
          <div class="stat-detail">
            <div>
              项目：<span class="stat-value"><i>￥</i>{taskStatsRes?.qd_price?.xmprice || 0}</span> 
            </div>
            <div>
              任务：<span class="stat-value"><i>￥</i>{taskStatsRes?.qd_price?.rwprice || 0}</span> 
            </div>
          </div>
        </div>
        <div class="stat-card">
          <div class="stat-title">本月完结单数</div>
          <div class="stat-detail">
            <div>项目：<span class="stat-value">{taskStatsRes?.end_num?.xmnum || 0}</span> </div>
            <div>任务：<span class="stat-value">{taskStatsRes?.end_num?.rwnum || 0}</span> </div>
          </div>
        </div>
        <div class="stat-card">
          <div class="stat-title">本月完结金额</div>
          <div class="stat-detail">
            <div>项目：<span class="stat-value"><i>￥</i>{taskStatsRes?.end_price?.xmprice || 0}</span> </div>
            <div>任务：<span class="stat-value"><i>￥</i>{taskStatsRes?.end_price?.rwprice || 0}</span> </div>
          </div>
        </div>
      </div>

      <!-- 筛选器触发按钮 -->
      <button class="filter-trigger" onclick="openFilterDrawer()">
        🔍 筛选条件
      </button>

      <!-- 筛选器抽屉 -->
      <div
        class="filter-drawer"
        id="filterDrawer"
        onclick="closeFilterDrawer(event)"
      >
        <div class="filter-drawer-content" onclick="event.stopPropagation()">
          <div class="filter-drawer-header">
            <h3 class="filter-drawer-title">🎯 筛选条件</h3>
            <button class="filter-drawer-close" onclick="closeFilterDrawer()"
              >✕</button
            >
          </div>

          <div class="filter-drawer-body">
            <!-- 基础筛选 -->
            <div class="filter-section">
              <h4 class="filter-section-title">基础筛选</h4>
              <div class="filter-grid two-cols">
                <div class="filter-item">
                  <span class="filter-item-icon">📋</span>
                  <select class="filter-select">
                    <option>全部项目和任务</option>
                  </select>
                </div>
                <div class="filter-item">
                  <span class="filter-item-icon">💰</span>
                  <select class="filter-select">
                    <option>开始金额</option>
                  </select>
                </div>
              </div>
              <div class="filter-grid" style="margin-top: 12px;">
                <div class="filter-item">
                  <span class="filter-item-icon">💵</span>
                  <select class="filter-select">
                    <option>结束金额</option>
                  </select>
                </div>
              </div>
            </div>

            <!-- 时间筛选 -->
            <div class="filter-section">
              <h4 class="filter-section-title">时间筛选</h4>
              <div class="filter-grid">
                <div class="filter-item">
                  <span class="filter-item-icon">📅</span>
                  <select class="filter-select">
                    <option>发布时间-开始时间</option>
                  </select>
                </div>
                <div class="filter-item">
                  <span class="filter-item-icon">📅</span>
                  <select class="filter-select">
                    <option>发布时间-结束时间</option>
                  </select>
                </div>
                <div class="filter-item">
                  <span class="filter-item-icon">⏰</span>
                  <select class="filter-select">
                    <option>截止时间-开始时间</option>
                  </select>
                </div>
                <div class="filter-item">
                  <span class="filter-item-icon">⏰</span>
                  <select class="filter-select">
                    <option>截止时间-结束时间</option>
                  </select>
                </div>
                <div class="filter-item">
                  <span class="filter-item-icon">🤝</span>
                  <select class="filter-select">
                    <option>接单时间-开始时间</option>
                  </select>
                </div>
                <div class="filter-item">
                  <span class="filter-item-icon">🤝</span>
                  <select class="filter-select">
                    <option>接单时间-结束时间</option>
                  </select>
                </div>
              </div>
            </div>
          </div>

          <div class="filter-drawer-footer">
            <div class="filter-actions">
              <button
                class="filter-btn filter-btn-secondary"
                onclick="resetFilters()"
              >
                🔄 重置
              </button>
              <button
                class="filter-btn filter-btn-primary"
                onclick="applyFilters()"
              >
                🔍 应用筛选
              </button>
            </div>
          </div>
        </div>
      </div>

      <div class="content">
        {taskListResData.code === 101 ? (
          <LoginExpiredMessage />
        ) : taskList.length === 0 ? (
          <div style="text-align: center; padding: 40px; color: #64748b;">
            {taskListResData.error ? `❌ ${taskListResData.error}` : '📭 暂无任务'}
          </div>
        ) : (
          <>
            <div id="taskListContainer">
              {taskList.map((task: any) => (
                <TaskCard task={task} />
              ))}
            </div>

            <div id="loadingIndicator" style="display: none; text-align: center; padding: 20px; color: #667eea;">
              <div style="display: inline-block; animation: spin 1s linear infinite;">⏳</div>
              <span style="margin-left: 10px;">加载中...</span>
            </div>

            <div id="noMoreData" style="display: none; text-align: center; padding: 20px; color: #94a3b8;">
              📭 已加载全部任务
            </div>

            <div class="pagination">
              📊 共 <span id="totalCount">{total}</span> 条记录
              已加载 <span id="loadedCount">{taskList.length}</span> 条
            </div>
          </>
        )}
      </div>
    </div>

    <script :inline src="/js/cookies.js"></script>
    <!-- 触底加载脚本 -->
    <script>
      import { createTaskCardHTML } from '../utils/taskCardTemplate';
      import { getCookie } from '../utils/tool';

      (function() {
        let currentPage = 1;
        let isLoading = false;
        let hasMore = true;
        const limit = 10;

        
        const clientToken = getCookie('token') || localStorage.getItem('token') || '';
        const clientEmployeeToken = getCookie('employee_token') || localStorage.getItem('employee_token') || '';

        // 获取 DOM 元素
        const taskListContainer = document.getElementById('taskListContainer');
        const loadingIndicator = document.getElementById('loadingIndicator');
        const noMoreData = document.getElementById('noMoreData');
        const totalCountEl = document.getElementById('totalCount');
        const loadedCountEl = document.getElementById('loadedCount');

        // 初始化总数
        const initialTotal = parseInt(totalCountEl?.textContent || '0');
        let loadedCount = parseInt(loadedCountEl?.textContent || '0');

        // 检查是否还有更多数据
        if (loadedCount >= initialTotal) {
          hasMore = false;
        }

        // 创建任务卡片 HTML - 使用共享模板函数
        function createTaskCard(task: any) {
          return createTaskCardHTML(task);
        }

        // 加载更多数据
        async function loadMore() {
          if (isLoading || !hasMore) {
            return;
          }

          isLoading = true;
          loadingIndicator && (loadingIndicator.style.display = 'block');
          noMoreData && (noMoreData.style.display = 'none');

          try {
            currentPage += 1;

            const response = await fetch(`/proxy`, {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
              },
              body: JSON.stringify({
                path: '/taskorder/orderindex',
                page: currentPage,
                limit: limit,
                enterpriseSide: 'pc'
              }),
            });

            if (response.status === 101) {
              window.location.href = '/login';
              return;
            }

            const result = await response.json();

            if (result.code === 101) {
              window.location.href = '/login';
              return;
            }

            if (result.code === 1) {
              const newTasks = result.data?.data || [];
              const total = result.data?.total || result.data?.count || 0;

              // 更新总数
              if (totalCountEl) {
                totalCountEl.textContent = total;
              }

              // 添加新任务到列表
              if (newTasks.length > 0) {
                newTasks.forEach((task: any) => {
                  const taskHTML = createTaskCard(task);
                  taskListContainer && taskListContainer.insertAdjacentHTML('beforeend', taskHTML);
                });

                loadedCount += newTasks.length;
                if (loadedCountEl) {
                  loadedCountEl.textContent = '' + loadedCount;
                }
              }

              // 检查是否还有更多数据
              if (loadedCount >= total || newTasks.length < limit) {
                hasMore = false;
                noMoreData && (noMoreData.style.display = 'block');
              }
            } else {
              console.error('加载失败:', result.msg || '未知错误');
              hasMore = false;
            }
          } catch (error) {
            console.error('加载失败:', error);
            hasMore = false;
          } finally {
            isLoading = false;
            loadingIndicator && (loadingIndicator.style.display = 'none');
          }
        }

        // 检测是否到达底部
        function checkScrollBottom() {
          // 获取滚动位置
          const scrollTop = window.pageYOffset || document.documentElement.scrollTop;
          const windowHeight = window.innerHeight;
          const documentHeight = document.documentElement.scrollHeight;

          // 距离底部还有 200px 时就开始加载
          if (scrollTop + windowHeight >= documentHeight - 200) {
            loadMore();
          }
        }

        // 防抖函数
        function debounce(func: (...args: any[]) => void, wait: number) {
          let timeout: any;
          return function executedFunction(...args: any[]) {
            const later = () => {
              clearTimeout(timeout);
              func(...args);
            };
            clearTimeout(timeout);
            timeout = setTimeout(later, wait);
          };
        }

        // 监听滚动事件（使用防抖）
        const debouncedScroll = debounce(checkScrollBottom, 200);
        window.addEventListener('scroll', debouncedScroll);

        // 初始检查一次（如果页面很短，直接显示没有更多数据）
        setTimeout(() => {
          if (!hasMore) {
            noMoreData && (noMoreData.style.display = 'block');
          }
        }, 100);
      })();
    </script>
  </body>
</html>
