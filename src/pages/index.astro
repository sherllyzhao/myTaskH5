---
import FilterDrawer from "../components/FilterDrawer.astro";
import MobilePicker from "../components/MobilePicker.astro";
import FilterSection from "../components/FilterSection.astro";
import ConfirmDialog from '../components/ConfirmDialog.astro';
import PageHeader from '../components/PageHeader.astro';
import StatsGrid from '../components/StatsGrid.astro';
import FilterBar from '../components/FilterBar.astro';
import type { FilterGroup } from "../types/filter";
import AlertBar from "../components/AlertBar.astro";

// 静态模式：数据由客户端加载
// 服务器端只提供空的初始值
let userInfo: any = null;
const taskStats: any = {};

// 筛选组件配置
const filterGroups: FilterGroup[] = [
  {
    title: "基础筛选",
    items: [
      {
        type: "input",
        icon: "📋",
        name: "name",
        placeholder: "项目名称或项目编号",
        width: "full"
      },
      {
        type: "picker",
        icon: "📁",
        name: "projectTask",
        placeholder: "项目类型",
        pickerKey: "projectTask",
        width: "full",
        defaultValue: '0',
        options: [
          {label: "全部项目和任务", value: "0"},
          {label: "仅项目", value: "1"},
          {label: "仅任务", value: "2"},
        ]
      },
      {
        type: "picker",
        icon: "🔽",
        name: "order",
        placeholder: "排序",
        pickerKey: "order",
        width: "full",
        defaultValue: "id",
        options: [
          {
            label: '发布时间由近到远排序',
            value: 'id',
          },
          {
            label: '佣金变更时间由近到远排序',
            value: 'commission_edittime',
          },
          {
            label: '工期到期天数由近到远排序',
            value: 'syday',
          }
        ]
      },
      {
        type: "number",
        icon: "💰",
        name: "amountStart",
        placeholder: "开始金额",
        width: "half",
      },
      {
        type: "number",
        icon: "💰",
        name: "amountEnd",
        placeholder: "结束金额",
        width: "half",
      }
    ]
  },
  {
    title: "时间筛选",
    items: [
      {
        type: "date-time-picker",
        icon: "📅",
        name: "publishStart",
        placeholder: "发布开始",
        pickerKey: "publishStart",
        width: "half"
      },
      {
        type: "date-time-picker",
        icon: "📅",
        name: "publishEnd",
        placeholder: "发布结束",
        pickerKey: "publishEnd",
        width: "half"
      },
      {
        type: "date-time-picker",
        icon: "📅",
        name: "deadlineStart",
        placeholder: "截止开始",
        pickerKey: "deadlineStart",
        width: "half"
      },
      {
        type: "date-time-picker",
        icon: "📅",
        name: "deadlineEnd",
        placeholder: "截止结束",
        pickerKey: "deadlineEnd",
        width: "half"
      },
      {
        type: "date-time-picker",
        icon: "📅",
        name: "orderStart",
        placeholder: "接单开始",
        pickerKey: "orderStart",
        width: "half"
      },
      {
        type: "date-time-picker",
        icon: "📅",
        name: "orderEnd",
        placeholder: "接单结束",
        pickerKey: "orderEnd",
        width: "half"
      }
    ]
  }
];

const basePath = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<html lang="zh-CN">
  <head>
        <script is:inline src={`${basePath}js/site-path.js?v=20260729-1`}></script>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href={`${basePath}favicon.svg`} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>任务管理</title>
    <link rel="stylesheet" href={`${basePath}common.css`} />
    <link rel="stylesheet" href={`${basePath}task-styles.css`} />
    <script is:inline src={`${basePath}js/auth.js`} defer></script>
  </head>
  <body>
    <!-- 移动端选择器弹层 -->
    <MobilePicker />

    <script is:inline src={`${basePath}js/drawer.js`}></script>
    <div class="container">
      <div class="wrap">
        <!-- <Debug data={userInfo} /> -->

        <PageHeader userInfo={userInfo} currentTab="hall" />

        <StatsGrid taskStats={taskStats} />

        <FilterBar />

        <div class="content">
          <!-- 任务列表容器 - 状态元素将自动创建 -->
          <div id="taskListContainer">
            <!-- 任务列表将由客户端动态加载 -->
          </div>
        </div>
      </div>

      <!-- 筛选器抽屉组件 -->
      <FilterDrawer id="filterDrawer" title="筛选条件">
        <Fragment slot="header">
          <h3 class="filter-drawer-title">筛选条件</h3>
          <button class="filter-drawer-close" onclick="closeFilterDrawer()"
            >✕</button
          >
        </Fragment>

        <!-- 筛选组件 -->
        <FilterSection groups={filterGroups} />

        <Fragment slot="footer">
          <div class="filter-actions">
            <button
              class="filter-btn filter-btn-secondary"
              onclick="resetFilters()">🔄 重置</button
            >
            <button
              class="filter-btn filter-btn-primary"
              onclick="applyFilters(window.loadInitialData)">🔍 应用筛选</button
            >
          </div>
        </Fragment>
      </FilterDrawer>

      <ConfirmDialog
          id="myDialog"
          title="提示"
          message="接单后需要根据内容指派，请及时把控工期进度。"
          confirmText="确定"
          cancelText="取消"
        />

	    <AlertBar type="error" id="takeError" fixed autoClose={true}/>
	    <AlertBar type="success" id="takeSuccess" fixed autoClose={true}/>
    </div>

    <script is:inline src={`${basePath}js/cookies.js`}></script>
    <script is:inline src={`${basePath}js/utils.js`}></script>

    <!-- 筛选器配置全局变量 -->
    <script is:inline define:vars={{ filterGroups }}>
      // 将筛选器配置设置为全局变量，供 MobilePicker 使用
      window.filterGroupsConfig = filterGroups;
    </script>

    <!-- 用户信息全局变量 -->
    <script is:inline define:vars={{ userInfo }}>
      let takeErrorBar = document.getElementById('takeError');
      let takeSuccessBar = document.getElementById('takeSuccess');

      // 静态模式：从 localStorage 获取用户信息，如果没有则从 API 获取
      window.currentUserInfo = userInfo || JSON.parse(localStorage.getItem('currentUserInfo') || 'null');

      // 客户端获取用户信息和统计数据
      (async function loadClientData() {
        const apiBase = getApiBase();
        const taskApiBase = getTaskApiBase();
        const token = getToken();

        // 检查登录状态
        if (!token) {
          redirectToLogin();
          return;
        }

        try {
          // 获取用户信息
          const userRes = await fetch(`${apiBase}/user/infoClient`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ tokens: token })
          });
          const userData = await userRes.json();
          if (userData.code === 200 && userData.data) {
            window.currentUserInfo = userData.data;
            localStorage.setItem('currentUserInfo', JSON.stringify(userData.data));
            // 更新页面头部显示的用户信息
            const userNameEl = document.querySelector('.user-name');
            if (userNameEl && userData.data.nick_name) {
              userNameEl.textContent = userData.data.nick_name;
            }
          }
        } catch (e) {
          console.error('获取用户信息失败:', e);
        }

        try {
          // 获取统计数据
          const statsRes = await fetch(`${taskApiBase}/taskorder/monthinfo`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ tokens: token })
          });
          const statsData = await statsRes.json();
          if (statsData.code === 1 && statsData.data) {
            // 更新统计卡片
            const stats = statsData.data;
            const monthMoney = document.querySelector('[data-stat="monthMoney"]');
            const monthCount = document.querySelector('[data-stat="monthCount"]');
            const totalMoney = document.querySelector('[data-stat="totalMoney"]');
            const totalCount = document.querySelector('[data-stat="totalCount"]');

            if (monthMoney) monthMoney.textContent = stats.monthMoney || '0';
            if (monthCount) monthCount.textContent = stats.monthCount || '0';
            if (totalMoney) totalMoney.textContent = stats.totalMoney || '0';
            if (totalCount) totalCount.textContent = stats.totalCount || '0';
          }
        } catch (e) {
          console.error('获取统计数据失败:', e);
        }
      })();

      console.log('当前用户信息:', window.currentUserInfo);

      // 处理接任务的全局函数（工具函数 isOldVersion, getTypeName 已在 utils.js 中定义）
      window.handleTaskAccept = function(event, taskId, taskCompanyId, taskCompanyName, task) {
        event.preventDefault();

        const currentUser = window.currentUserInfo;

        // 如果没有用户信息，提示登录
        if (!currentUser) {
          showError('请先登录', takeErrorBar);
          window.location.href = window.sitePath('/login');
          return;
        }

        // 获取用户的公司ID（根据实际的数据结构调整）
        const userCompanyName = currentUser?.companyInfo?.company_name || currentUser.companyName || '';

        // 检查是否为非本公司任务
        if (taskCompanyId && userCompanyName && taskCompanyName !== userCompanyName) {
          const taskCompanyText = taskCompanyName ? `"${taskCompanyName}"` : '其他公司';
          const userCompanyText = userCompanyName ? `您当前所属公司为"${userCompanyName}"` : '';

          const confirmMessage = `⚠️ 注意：这是${taskCompanyText}发布的任务！\n${userCompanyText}\n\n是否确认接取此任务？`;

          if (!confirm(confirmMessage)) {
            return; // 用户取消接取
          }
        }

        // 检查是否为旧版本任务
        if(isOldVersion(task.orderType)){
          showError(`该条${getTypeName(task.orderType)}为旧版本，请到PC端接取`, takeErrorBar);
          return;
        }

        // 执行接任务的逻辑
        try {
          const dialog = document.getElementById('myDialog');
          if (!dialog || !dialog.show) {
            showError('对话框组件未找到', takeErrorBar);
            return;
          }
            dialog.show({
              message: '接单后需要根据内容指派，请及时把控工期进度。',
              onConfirm: async () => {
                  dialog.dataset.loading = 'true';
                  try{
                    // 使用公共函数获取 API 地址
                    const taskApiBase = getTaskApiBase();
                    const response = await fetch(`${taskApiBase}/taskorder/addtask`, {
                      method: 'POST',
                      headers: { 'Content-Type': 'application/json' },
                      body: JSON.stringify({ id: taskId, remark: '1', tokens: Cookies.get('employee_token') })
                    });
                    if(response.ok){
                      if(response.status === 200){
                        const res = await response.json();
                        if(res.code === 1){
                          // 处理成功逻辑
                          showSuccess('接单成功，祝您工作愉快！', takeSuccessBar);
                          window.location.reload();
                        }else{
                          showError(res.msg || res.message || "接取任务失败，请重试", takeErrorBar);
                        }
                      }else{
                        showError('接取任务失败，请重试', takeErrorBar);
                      }
                    }
                  } catch (error) {
                    showError('接取任务失败，请重试', takeErrorBar);
                  } finally {
                    dialog.dataset.loading = 'false';
                  }
              },
              onCancel: () => {
                console.log('用户点击了取消');
              }
            });

          console.log('接取任务:', taskId);

          // 刷新列表或跳转到任务详情页
          // window.location.reload();
          // 或者
          // window.location.href = `/task/${taskId}/`;

        } catch (error) {
          console.error('接取任务失败:', error);
          showError('接取任务失败，请重试', takeErrorBar);
        }
      };
    </script>

    <!-- 触底加载脚本 -->
    <script>
      import { createTaskCardHTML } from "../utils/taskCardTemplate";
      import { getCookie } from "../utils/tool";
      import { createListStateManager } from "../utils/listStateManager";
      import { getTaskApiBase } from "../utils/apiConfig";

      // ===== 页面字段配置 =====
      // 设置为全局变量，供 getFilterFormData 使用
      window.pageFieldConfig = {
        singleFields: {
          name: 'name',
          orderType: 'projectTask',
          sort: 'order'
        },
        rangeFields: {
          moneyInput: ['amountStart', 'amountEnd'],
          ordertime: ['publishStart', 'publishEnd'],
          enddatatime: ['deadlineStart', 'deadlineEnd'],
          performtime: ['orderStart', 'orderEnd']
        }
      };

      // 全局变量定义
      let currentPage = 0; // 从0开始,第一次加载就是第1页
      let isLoading = false;
      let hasMore = true;
      const limit = 10;
      let globalFormData = {};

      // 获取 API 基础地址（静态部署兼容）
      const taskApiBase = getTaskApiBase();

      // 获取 DOM 元素
      const taskListContainer = document.getElementById("taskListContainer");

      // ===== 初始化状态管理器 =====
      const stateManager = createListStateManager();

      // 创建任务卡片 HTML - 使用共享模板函数
      function createTaskCard(task: any) {
        return createTaskCardHTML(task);
      }

      // 全局加载数据函数
      window.loadInitialData = async function(formData: any = {}) {
        globalFormData = formData;
          if (isLoading) return;

          isLoading = true;
          hasMore = true;

          // 使用状态管理器显示加载状态
          if (stateManager) {
            stateManager.onRequestStart();
          }

          try {
            currentPage = 1;

            // 静态模式：直接调用后端 API
            const response = await fetch(`${taskApiBase}/taskorder/orderindex`, {
              method: "POST",
              headers: {
                "Content-Type": "application/json",
              },
              body: JSON.stringify({
                enterpriseSide: "pc",
                page: currentPage,
                limit: limit,
                tokens: getCookie('employee_token') || localStorage.getItem('employee_token') || '',
                ...formData
              }),
            });

            if (response.status === 401) {
              window.location.href = window.sitePath("/login");
              return;
            }

            const result = await response.json();

            if (result.code === 401) {
              window.location.href = window.sitePath("/login");
              return;
            }

            if (result.code === 1) {
              const tasks = result.data?.data || [];
              const total = result.data?.total || result.data?.count || 0;

              // 清空容器并添加新任务
              if (taskListContainer) {
                taskListContainer.innerHTML = "";

                if (tasks.length > 0) {
                  tasks.forEach((task: any) => {
                    if (Object.prototype.toString.call(task.description) === '[object Array]') {
                      task.description = task.description.map((d: any) => d.condition_title + '：' + d.condition)
                      if (task.description.length > 0) {
                        task.description = task.description.join('\n')
                      }
                    }

                    const taskHTML = createTaskCard(task);
                    taskListContainer.insertAdjacentHTML("beforeend", taskHTML);
                  });
                } else {
                  // 没有数据时显示提示
                  taskListContainer.innerHTML = '<div style="text-align: center; padding: 40px; color: #666;">📭 暂无任务</div>';
                }
              }

              // 使用状态管理器更新状态
              const isComplete = stateManager.onRequestSuccess(total, tasks.length, limit);
              hasMore = !isComplete;

            } else {
              console.error("加载失败:", result.msg || result.message || "未知错误");
              if (taskListContainer) {
                taskListContainer.innerHTML = '<div style="text-align: center; padding: 40px; color: #f56565;">❌ 加载失败</div>';
              }
              stateManager.onRequestError();
            }
          } catch (error) {
            console.error("加载失败:", error);
            if (taskListContainer) {
              taskListContainer.innerHTML = '<div style="text-align: center; padding: 40px; color: #f56565;">❌ 网络错误</div>';
            }
            stateManager.onRequestError();
          } finally {
            isLoading = false;
          }
        }

        const clientToken =
          getCookie("token") || localStorage.getItem("token") || "";
        const clientEmployeeToken =
          getCookie("employee_token") ||
          localStorage.getItem("employee_token") ||
          "";

        // 加载更多数据
        window.loadMore = async function() {
          if (isLoading || !hasMore) {
            return;
          }

          isLoading = true;
          stateManager.onRequestStart(); // 自动显示加载中状态

          try {
            currentPage += 1;

            // 静态模式：直接调用后端 API
            const response = await fetch(`${taskApiBase}/taskorder/orderindex`, {
              method: "POST",
              headers: {
                "Content-Type": "application/json",
              },
              body: JSON.stringify({
                enterpriseSide: "pc",
                page: currentPage,
                limit: limit,
                tokens: getCookie('employee_token') || localStorage.getItem('employee_token') || '',
                ...globalFormData
              }),
            });

            if (response.status === 401) {
              window.location.href = window.sitePath("/login");
              return;
            }

            const result = await response.json();

            if (result.code === 401 || result.code === 401) {
              window.location.href = window.sitePath("/login");
              return;
            }

            if (result.code === 1) {
              const newTasks = result.data?.data || [];
              const total = result.data?.total || result.data?.count || 0;

              // 添加新任务到列表
              if (newTasks.length > 0) {
                newTasks.forEach((task: any) => {
                  const taskHTML = createTaskCard(task);
                  taskListContainer &&
                    taskListContainer.insertAdjacentHTML("beforeend", taskHTML);
                });
              }

              // 计算当前已加载总数
              const currentLoaded = (taskListContainer?.children.length || 0);

              // 使用状态管理器更新状态
              const isComplete = stateManager.onRequestSuccess(total, currentLoaded, limit);
              hasMore = !isComplete;

            } else {
              console.error("加载失败:", result.msg || result.message || "未知错误");
              stateManager.onRequestError();
              hasMore = false;
            }
          } catch (error) {
            console.error("加载失败:", error);
            stateManager.onRequestError();
            hasMore = false;
          } finally {
            isLoading = false;
          }
        }

        // 检测是否到达底部
        function checkScrollBottom() {
          // 获取 .wrap 滚动容器
          const wrapElement = document.querySelector('.wrap');
          if (!wrapElement) return;

          // 获取滚动位置
          const scrollTop = wrapElement.scrollTop;
          const scrollHeight = wrapElement.scrollHeight;
          const clientHeight = wrapElement.clientHeight;

          // 距离底部还有 200px 时就开始加载
          if (scrollTop + clientHeight >= scrollHeight - 200) {
            window.loadMore();
          }
        }

        // 防抖函数
        function debounce(func: (...args: any[]) => void, wait: number) {
          let timeout: any;
          return function executedFunction(...args: any[]) {
            const later = () => {
              clearTimeout(timeout);
              func(...args);
            };
            clearTimeout(timeout);
            timeout = setTimeout(later, wait);
          };
        }

        // 监听 .wrap 元素的滚动事件（使用防抖）
        const debouncedScroll = debounce(checkScrollBottom, 200);
        const wrapElement = document.querySelector('.wrap');
        if (wrapElement) {
          wrapElement.addEventListener("scroll", debouncedScroll);
        }

        // 页面加载时立即获取初始数据
        window.loadInitialData();
    </script>
  </body>
</html>
