---
import FilterDrawer from "../components/FilterDrawer.astro";
import MobilePicker from "../components/MobilePicker.astro";
import FilterSection from "../components/FilterSection.astro";
import PageHeader from '../components/PageHeader.astro';
import StatsGrid from '../components/StatsGrid.astro';
import FilterBar from '../components/FilterBar.astro';
import ConfirmDialog from '../components/ConfirmDialog.astro';
import type { FilterGroup } from "../types/filter";

// 初始化空数据,由客户端加载

/* 统计 */
let taskStatsRes: any;
let userInfo: any = null;
const proxyUrl = `${Astro.url.origin}/proxy`;
const proxyChina9Url = `${Astro.url.origin}/proxyChina9`;

try {
  // 获取用户信息
  const userInfoResponse = await fetch(proxyChina9Url, {
    method: "POST",
    headers: {
      "Content-Type": "application/json",
      "Cookie": Astro.request.headers.get("cookie") || "",
    },
    body: JSON.stringify({
      path: "/user/infoClient",
    }),
  });

  if (userInfoResponse.status === 200) {
    const userInfoResult = await userInfoResponse.json();
    if (userInfoResult.code === 200) {
      userInfo = userInfoResult.data;
    }
  }
} catch (error: any) {
  console.error("❌ 获取用户信息失败:", error);
}

try {
  // 统计数据
  const statsResponse = await fetch(proxyUrl, {
    method: "POST",
    headers: {
      "Content-Type": "application/json",
      "Cookie": Astro.request.headers.get("cookie") || "",
    },
    body: JSON.stringify({
      path: "/taskorder/monthinfo",
    }),
  });
  // 检查HTTP状态码401
  if (statsResponse.status === 401) {
    // 在SSR环境下无法直接跳转,返回空数据让前端处理
    taskStatsRes = {
      list: [],
      total: 0,
      error: "未授权,请重新登录",
      code: 401,
    };
  } else {
    const statsRes = await statsResponse.json();
    // 检查业务状态码401
    if (statsRes.code === 401) {
      taskStatsRes = {
        data: {},
        error: "未授权,请重新登录",
        code: 401,
      };
    } else if (statsRes.code === 1) {
      taskStatsRes = statsRes.data || statsRes;
    }
  }
} catch (error: any) {
  console.error("❌ SSR Error:", error);
}

const taskStats = taskStatsRes || {};

// 筛选组件配置
const filterGroups: FilterGroup[] = [
  {
    title: "基础筛选",
    items: [
      {
        type: "input",
        icon: "📋",
        name: "name",
        placeholder: "项目名称或项目编号",
        width: "full"
      },
      {
        type: "picker",
        icon: "📁",
        name: "projectTask",
        placeholder: "项目类型",
        pickerKey: "projectTask",
        width: "full",
        defaultValue: '0',
        options: [
          {label: "全部项目和任务", value: "0"},
          {label: "仅项目", value: "1"},
          {label: "仅任务", value: "2"},
        ]
      },
      {
        type: "picker",
        icon: "✅",
        name: "status",
        placeholder: "执行状态",
        pickerKey: "status",
        width: "full",
        defaultValue: '',
        options: [
			{value: "1", label: '已接单'},
			{value: "2", label: '核对中'},
			{value: "3", label: '待质检'},
			{value: "4", label: '已完结'},
			{value: "5", label: '已逾期'},
			{value: "6", label: '已转移'},
        ]
      },
      {
        type: "picker",
        icon: "🔽",
        name: "order",
        placeholder: "排序",
        pickerKey: "order",
        width: "full",
        defaultValue: "",
        options: [
          {
            label: '发布时间由近到远排序',
            value: 'id',
          },
          {
            label: '佣金变更时间由近到远排序',
            value: 'commission_edittime',
          },
          {
            label: '工期到期天数由近到远排序',
            value: 'syday',
          }
        ]
      },
      {
        type: "number",
        icon: "💰",
        name: "amountStart",
        placeholder: "开始金额",
        width: "half",
      },
      {
        type: "number",
        icon: "💰",
        name: "amountEnd",
        placeholder: "结束金额",
        width: "half",
      }
    ]
  },
  {
    title: "时间筛选",
    items: [
      {
        type: "date-time-picker",
        icon: "📅",
        name: "publishStart",
        placeholder: "发布开始",
        pickerKey: "publishStart",
        width: "half"
      },
      {
        type: "date-time-picker",
        icon: "📅",
        name: "publishEnd",
        placeholder: "发布结束",
        pickerKey: "publishEnd",
        width: "half"
      },
      {
        type: "date-time-picker",
        icon: "📅",
        name: "deadlineStart",
        placeholder: "截止开始",
        pickerKey: "deadlineStart",
        width: "half"
      },
      {
        type: "date-time-picker",
        icon: "📅",
        name: "deadlineEnd",
        placeholder: "截止结束",
        pickerKey: "deadlineEnd",
        width: "half"
      },
      {
        type: "date-time-picker",
        icon: "📅",
        name: "orderStart",
        placeholder: "接单开始",
        pickerKey: "orderStart",
        width: "half"
      },
      {
        type: "date-time-picker",
        icon: "📅",
        name: "orderEnd",
        placeholder: "接单结束",
        pickerKey: "orderEnd",
        width: "half"
      },
      {
        type: "date-time-picker",
        icon: "📅",
        name: "completeStart",
        placeholder: "完成开始",
        pickerKey: "completeStart",
        width: "half"
      },
      {
        type: "date-time-picker",
        icon: "📅",
        name: "completeEnd",
        placeholder: "完成结束",
        pickerKey: "completeEnd",
        width: "half"
      }
    ]
  }
];
---

<html lang="zh-CN">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="generator" content={Astro.generator} />
		<title>我的任务</title>
		<link rel="stylesheet" href="/common.css" />
		<link rel="stylesheet" href="/task-styles.css" />
		<script src="/js/auth.js" defer></script>
	</head>
	<body>
		<!-- 移动端选择器弹层 -->
		<MobilePicker />

		<script is:inline src="/js/drawer.js"></script>
		<div class="container">
			<div class="wrap">
				<PageHeader userInfo={userInfo} currentTab="tasks" />

				<StatsGrid taskStats={taskStats} />

				<FilterBar />

				<div class="content">
					<!-- 任务列表容器 - 状态元素将自动创建 -->
					<div id="taskListContainer">
						<!-- 任务列表将由客户端动态加载 -->
					</div>
				</div>
			</div>

			<!-- 筛选器抽屉组件 -->
			<FilterDrawer id="filterDrawer" title="筛选条件">
				<Fragment slot="header">
					<h3 class="filter-drawer-title">筛选条件</h3>
					<button class="filter-drawer-close" onclick="closeFilterDrawer()">✕</button>
				</Fragment>

				<!-- 筛选组件 -->
				<FilterSection groups={filterGroups} />

				<Fragment slot="footer">
					<div class="filter-actions">
						<button class="filter-btn filter-btn-secondary" onclick="resetFilters()">🔄 重置</button>
						<button class="filter-btn filter-btn-primary" onclick="applyFilters(window.loadInitialData)">🔍 应用筛选</button>
					</div>
				</Fragment>
			</FilterDrawer>

			<ConfirmDialog
				id="myDialog"
				title="提示"
				message="接单后需要根据内容指派，请及时把控工期进度。"
				confirmText="确定"
				cancelText="取消"
			/>
		</div>

		<script :inline src="/js/cookies.js"></script>

		<!-- 筛选器配置全局变量 -->
		<script is:inline define:vars={{ filterGroups }}>
			// 将筛选器配置设置为全局变量，供 MobilePicker 使用
			window.filterGroupsConfig = filterGroups;
		</script>

		<!-- 用户信息全局变量 -->
		<script is:inline define:vars={{ userInfo }}>
			// 将用户信息设置为全局变量
			window.currentUserInfo = userInfo;
			localStorage.setItem('currentUserInfo', JSON.stringify(userInfo));
			console.log('当前用户信息:', window.currentUserInfo);
		</script>

		<!-- 触底加载脚本 -->
		<script>
			import { createTaskCardHTML } from "../utils/taskCardTemplate";
			import { getCookie } from "../utils/tool";
			import { createListStateManager } from "../utils/listStateManager";

			// ===== 页面字段配置 =====
			// 设置为全局变量，供 getFilterFormData 使用
			window.pageFieldConfig = {
				singleFields: {
					name: 'name',
					orderType: 'projectTask',
					status: 'status',
					sort: 'order',
				},
				rangeFields: {
					ordertime: ['publishStart', 'publishEnd'],
					enddatatime: ['deadlineStart', 'deadlineEnd'],
					performtime: ['orderStart', 'orderEnd'],
					completiontime: ['completeStartStart', 'completeStartEnd'],
					bountymoney: ['amountStart', 'amountEnd']
				}
			};

			// 全局变量定义
			let currentPage = 0; // 从0开始,第一次加载就是第1页
			let isLoading = false;
			let hasMore = true;
			const limit = 10;
			let globalFormData = {};

			// 请求配置 - 使用 myorderindex 接口
			const requestConfig = {
				path: "/taskorder/myorderindex",
				enterpriseSide: "pc"
			};

			// 获取 DOM 元素
			const taskListContainer = document.getElementById("taskListContainer");

			// ===== 初始化状态管理器 =====
			const stateManager = createListStateManager();

			// 创建任务卡片 HTML - 使用共享模板函数
			function createTaskCard(task: any) {
				return createTaskCardHTML(task);
			}

			// 全局加载数据函数
			window.loadInitialData = async function(formData: any = {}) {
				globalFormData = formData;
				if (isLoading) return;

				isLoading = true;
				hasMore = true;

				// 使用状态管理器显示加载状态
				if (stateManager) {
					stateManager.onRequestStart();
				}

				try {
					currentPage = 1;

					// 发送请求
					const response = await fetch(`/proxy`, {
						method: "POST",
						headers: {
							"Content-Type": "application/json",
						},
						body: JSON.stringify({
							...requestConfig,
							page: currentPage,
							limit: limit,
							...formData,
							order: 'desc',
							hall_type: '',
							status: formData.status ?? ''
						}),
					});

					if (response.status === 401) {
						window.location.href = "/login";
						return;
					}

					const result = await response.json();

					if (result.code === 401) {
						window.location.href = "/login";
						return;
					}

					if (result.code === 1) {
						const tasks = result.data?.data || [];
						const total = result.data?.total || result.data?.count || 0;

						// 清空容器并添加新任务
						if (taskListContainer) {
							taskListContainer.innerHTML = "";

							if (tasks.length > 0) {
								tasks.forEach((task: any) => {
									if (Object.prototype.toString.call(task.description) === '[object Array]') {
										task.description = task.description.map((d: any) => d.condition_title + '：' + d.condition)
										if (task.description.length > 0) {
											task.description = task.description.join('\n')
										}
									}

									const taskHTML = createTaskCard(task);
									taskListContainer.insertAdjacentHTML("beforeend", taskHTML);
								});
							} else {
								// 没有数据时显示提示
								taskListContainer.innerHTML = '<div style="text-align: center; padding: 40px; color: #666;">📭 暂无任务</div>';
							}
						}

						// 使用状态管理器更新状态
						const isComplete = stateManager.onRequestSuccess(total, tasks.length, limit);
						hasMore = !isComplete;

					} else {
						console.error("加载失败:", result.msg || "未知错误");
						if (taskListContainer) {
							taskListContainer.innerHTML = '<div style="text-align: center; padding: 40px; color: #f56565;">❌ 加载失败</div>';
						}
						stateManager.onRequestError();
					}
				} catch (error) {
					console.error("加载失败:", error);
					if (taskListContainer) {
						taskListContainer.innerHTML = '<div style="text-align: center; padding: 40px; color: #f56565;">❌ 网络错误</div>';
					}
					stateManager.onRequestError();
				} finally {
					isLoading = false;
				}
			}

			const clientToken =
				getCookie("token") || localStorage.getItem("token") || "";
			const clientEmployeeToken =
				getCookie("employee_token") ||
				localStorage.getItem("employee_token") ||
				"";

			// 加载更多数据
			window.loadMore = async function() {
				if (isLoading || !hasMore) {
					return;
				}

				isLoading = true;
				stateManager.onRequestStart(); // 自动显示加载中状态

				try {
					currentPage += 1;

					const response = await fetch(`/proxy`, {
						method: "POST",
						headers: {
							"Content-Type": "application/json",
						},
						body: JSON.stringify({
							...requestConfig,
							page: currentPage,
							limit: limit,
							...globalFormData,
							order: 'desc',
							hall_type: '',
							status: globalFormData.status ?? ''
						}),
					});

					if (response.status === 401) {
						window.location.href = "/login";
						return;
					}

					const result = await response.json();

					if (result.code === 401 || result.code === 401) {
						window.location.href = "/login";
						return;
					}

					if (result.code === 1) {
						const newTasks = result.data?.data || [];
						const total = result.data?.total || result.data?.count || 0;

						// 添加新任务到列表
						if (newTasks.length > 0) {
							newTasks.forEach((task: any) => {
								const taskHTML = createTaskCard(task);
								taskListContainer &&
									taskListContainer.insertAdjacentHTML("beforeend", taskHTML);
							});
						}

						// 计算当前已加载总数
						const currentLoaded = (taskListContainer?.children.length || 0);

						// 使用状态管理器更新状态
						const isComplete = stateManager.onRequestSuccess(total, currentLoaded, limit);
						hasMore = !isComplete;

					} else {
						console.error("加载失败:", result.msg || "未知错误");
						stateManager.onRequestError();
						hasMore = false;
					}
				} catch (error) {
					console.error("加载失��:", error);
					stateManager.onRequestError();
					hasMore = false;
				} finally {
					isLoading = false;
				}
			}

			// 检测是否到达底部
			function checkScrollBottom() {
				// 获取 .wrap 滚动容器
				const wrapElement = document.querySelector('.wrap');
				if (!wrapElement) return;

				// 获取滚动位置
				const scrollTop = wrapElement.scrollTop;
				const scrollHeight = wrapElement.scrollHeight;
				const clientHeight = wrapElement.clientHeight;

				// 距离底部还有 200px 时就开始加载
				if (scrollTop + clientHeight >= scrollHeight - 200) {
					window.loadMore();
				}
			}

			// 防抖函数
			function debounce(func: (...args: any[]) => void, wait: number) {
				let timeout: any;
				return function executedFunction(...args: any[]) {
					const later = () => {
						clearTimeout(timeout);
						func(...args);
					};
					clearTimeout(timeout);
					timeout = setTimeout(later, wait);
				};
			}

			// 监听 .wrap 元素的滚动事件（使用防抖）
			const debouncedScroll = debounce(checkScrollBottom, 200);
			const wrapElement = document.querySelector('.wrap');
			if (wrapElement) {
				wrapElement.addEventListener("scroll", debouncedScroll);
			}

			// 页面加载时立即获取初始数据
			window.loadInitialData();
		</script>
	</body>
</html>
