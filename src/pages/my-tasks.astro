<html lang="zh-CN">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="generator" content={Astro.generator} />
		<title>我的任务</title>
		<link rel="stylesheet" href="/common.css" />
		<style>
			/* 我的任务页面特有样式 */
			.task-card {
				position: relative;
			}
			
			.task-header {
				display: flex;
				justify-content: space-between;
				align-items: flex-start;
				margin-bottom: 12px;
			}
			
			.task-title {
				font-size: 14px;
				font-weight: bold;
				color: #333;
				flex: 1;
				margin-right: 8px;
				line-height: 1.3;
			}
			
			.task-status {
				padding: 4px 8px;
				border-radius: 4px;
				font-size: 11px;
				font-weight: bold;
				white-space: nowrap;
			}
			
			.task-meta {
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 8px;
				margin-bottom: 12px;
			}
			
			.meta-item {
				font-size: 12px;
			}
			
			.meta-label {
				color: #666;
				margin-bottom: 2px;
			}
			
			.meta-value {
				color: #333;
				font-weight: 500;
			}
			
			.task-dates {
				background: #f8f9fa;
				padding: 8px;
				border-radius: 4px;
				margin-bottom: 12px;
			}
			
			.dates-row {
				display: flex;
				justify-content: space-between;
				font-size: 11px;
				margin-bottom: 4px;
			}
			
			.dates-row:last-child {
				margin-bottom: 0;
			}
			
			.date-label {
				color: #666;
			}
			
			.date-value {
				color: #333;
			}
			
			.task-amounts {
				display: grid;
				grid-template-columns: 1fr 1fr 1fr;
				gap: 8px;
				margin-bottom: 12px;
			}
			
			.amount-item {
				text-align: center;
				padding: 8px;
				background: #f8f9fa;
				border-radius: 4px;
			}
			
			.amount-label {
				font-size: 10px;
				color: #666;
				margin-bottom: 4px;
			}
			
			.amount-value {
				font-size: 12px;
				font-weight: bold;
				color: #f56c6c;
			}
			
			.task-remarks {
				font-size: 12px;
				color: #666;
				line-height: 1.4;
				margin-bottom: 12px;
				background: #f8f9fa;
				padding: 8px;
				border-radius: 4px;
			}
			
			.task-action {
				text-align: center;
			}
			
			.task-action .action-btn {
				width: 100%;
			}
		</style>
	</head>
	<body>
